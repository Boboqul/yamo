импорт "парсер.ямо";

функция осмотр(словарь node, целое level) {
    текст kind = node["kind"];
    вывод повторить("  ", level) + kind + " -> ключи: " + json_собрать(ключи(node));
    если (kind == "func") { осмотр_блока(node["body"], level + 1); }
    если (kind == "while" или kind == "for") {
        если (содержит_ключ(node, "body")) { осмотр_блока(node["body"], level + 1); }
    }
    если (kind == "if") {
        если (содержит_ключ(node, "then")) { осмотр_блока(node["then"], level + 1); }
        если (содержит_ключ(node, "else")) { осмотр_блока(node["else"], level + 1); }
        если (содержит_ключ(node, "elifs")) {
            массив el = node["elifs"];
            для (целое i = 0; i < длина(el); i = i + 1) { осмотр(el[i], level + 1); }
        }
    }
}

функция осмотр_блока(массив body, целое level) {
    для (целое i = 0; i < длина(body); i = i + 1) {
        осмотр(body[i], level);
    }
}

функция главная() {
    словарь ast = разбор_программы(новое_состояние(), tokenize(читать_файл("программ.ямо")));
    осмотр_блока(ast["body"], 0);
}
