// demo_selfhost.yamo — Корректная демонстрация самохостинга
// Читает компоненты из папки библиотека/ относительно текущего каталога

функция главная() {
    вывод "=== ЯМО САМОХОСТИНГ v2026.09.24 ===";
    
    // Пути ОТНОСИТЕЛЬНЫЕ текущей директории, где запущен yamo.exe
    текст path_reader = "библиотека/читатель.ямо";
    текст path_parser = "библиотека/составитель.ямо";
    текст path_executor = "библиотека/мини_исполнитель.ямо";
    
    вывод "Читаю компоненты из библиотеки...";
    
    // Проверяем существование файлов перед чтением (для диагностики)
    если (существует_файл(path_reader) == ложь) {
        вывод "ОШИБКА: Не найден " + path_reader;
        вернуть 0;
    }
    если (существует_файл(path_parser) == ложь) {
        вывод "ОШИБКА: Не найден " + path_parser;
        вернуть 0;
    }
    если (существует_файл(path_executor) == ложь) {
        вывод "ОШИБКА: Не найден " + path_executor;
        вернуть 0;
    }
    
    текст c_r = читать_файл(path_reader);
    текст c_p = читать_файл(path_parser);
    текст c_e = читать_файл(path_executor);
    
    вывод "Размеры: R=" + длина(c_r) + ", P=" + длина(c_p) + ", E=" + длина(c_e);
    
    // Склейка кода с разделителями
    текст full_src = c_r + "`n//---R_END---`n" + c_p + "`n//---P_END---`n" + c_e + "`n//---E_END---`n";
    
    // Добавляем тестовую задачу (Фибоначчи)
    текст task = "";
    task = task + "функция fib(целое n) { ";
    task = task + "если (n <= 1) { вернуть n; } ";
    task = task + "вернуть fib(n - 1) + fib(n - 2); ";
    task = task + "} ";
    task = task + "вывод fib(10);";
    
    текст final_source = full_src + task;
    
    вывод "Парсинг AST (" + длина(final_source) + " симв)...";
    
    словарь lex;
    разобрать_код(final_source, lex);
    массив toks = lex["токены"];
    
    словарь par;
    составить(toks, par);
    массив nodes = par["узлы"];
    
    вывод "Токенов: " + длина(toks) + ", Узлов: " + длина(nodes);
    
    // Проверка ошибок парсинга
    логическое ok = истина;
    целое i = 0;
    пока (i < длина(nodes)) {
        если (nodes[i]["тип"] == "ОШИБКА") { 
            ok = ложь; 
            вывод "ОШИБКА ПАРСЕРА #" + i;
            прервать;
        }
        i = i + 1;
    }
    
    если (ok == ложь) {
        вернуть 0;
    }
    
    вывод "Исполнение внутреннего интерпретатора...";
    словарь env;
    исполнить_программу(nodes, env);
    
    вывод "=== УСПЕХ: fib(10) вычислен ===";
}