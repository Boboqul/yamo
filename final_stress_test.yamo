// final_stress_test.yamo — Комплексная проверка ООП ЯМО v2026.09.24

// --- БАЗОВЫЙ ИНТЕРФЕЙС ---
класс ЖивоеСущество {
    текст имя;
    целое возраст;
    
    функция инициализация(текст n, целое a) {
        этот.имя = n;
        этот.возраст = a;
    }
    
    функция дышать() {
        вернуть этот.имя + " дышит.";
    }
}

// --- НАСЛЕДОВАНИЕ 1: КОШКА ---
класс Кошка : ЖивоеСущество {
    текст цвет_шерсти;
    
    функция инициализация(текст n, целое a, текст c) {
        этот.имя = n;
        этот.возраст = a;
        этот.цвет_шерсти = c;
    }
    
    // Переопределение метода
    функция дышать() {
        вернуть этот.имя + " мурлычет при дыхании.";
    }
    
    функция мяукать() {
        вернуть "МЯУ!";
    }
}

// --- НАСЛЕДОВАНИЕ 2: СОБАКА ---
класс Собака : ЖивоеСущество {
    текст порода; 
    
    функция инициализация(текст n, целое a, текст p) {
        этот.имя = n;
        этот.возраст = a;
        этот.порода = p;
    }
    
    функция лаять() {
        вернуть "ГАВ!";
    }
}

// --- ГЛАВНАЯ ЛОГИКА ТЕСТА ---
функция главная() {
    вывод "==========================================";
    вывод "   ФИНАЛЬНЫЙ СТРЕСС-ТЕСТ ООП ЯМО";
    вывод "==========================================";
    
    // 1. Проверка базовой инициализации
    вывод "";
    вывод "[ТЕСТ 1] Инициализация объектов...";
    
    Кошка к1 = новый Кошка("Барсик", 3, "Рыжий");
    Собака с1 = новый Собака("Рекс", 5, "Овчарка");
    
    // Используем простое сравнение == вместо -match
    если (к1.имя == "Барсик") {
        если (к1.возраст == 3) {
            вывод "✓ Кошка инициализирована верно.";
        } иначе {
            вывод "✗ ОШИБКА: Возраст кошки неверен!";
        }
    } иначе {
        вывод "✗ ОШИБКА: Имя кошки повреждено!";
    }
    
    если (с1.имя == "Рекс") {
        если (с1.возраст == 5) {
            вывод "✓ Собака инициализирована верно.";
        } иначе {
            вывод "✗ ОШИБКА: Возраст собаки неверен!";
        }
    } иначе {
        вывод "✗ ОШИБКА: Имя собаки повреждено!";
    }
    
    // 2. Проверка полиморфизма
    вывод "";
    вывод "[ТЕСТ 2] Полиморфизм методов...";
    
    текст звук_кошки = к1.дышать();
    текст звук_собаки = с1.дышать();
    
    вывод "Кошка: " + звук_кошки;
    вывод "Собака: " + звук_собаки;
    
    // Простая проверка подстроки через длину или сравнение первых символов
    // Так как у нас нет indexOf/contains, проверим факт изменения текста
    если (звук_кошки != "Барсик дышит.") {
         вывод "✓ Метод 'дышать' переопределен правильно для Кошки.";
    } иначе {
         вывод "✗ ОШИБКА: Наследование методов сломано!";
    }
    
    // 3. Уникальные методы
    вывод "";
    вывод "[ТЕСТ 3] Доступ к уникальным методам...";
    
    вывод "Кошка говорит: " + к1.мяукать();
    вывод "Собака говорит: " + с1.лаять();
    
    // 4. Нагрузочный тест (уменьшим до 10k для скорости отладки, потом увеличим)
    вывод "";
    вывод "[ТЕСТ 4] Нагрузочный тест: 10,000 объектов...";
    
    целое сумма_возрастов = 0;
    целое i = 0;
    целое кол_во_ошибок = 0;
    
    пока (i < 10000) {
        если (i % 2 == 0) {
            Кошка tmp_k = новый Кошка("Кот_" + i, i % 10, "Цвет_" + i);
            сумма_возрастов = сумма_возрастов + tmp_k.возраст;
            
            // Выборочная проверка целостности
            если (i % 1000 == 0) {
                текст ожидаемое_имя = "Кот_" + i;
                если (tmp_k.имя != ожидаемое_имя) {
                    кол_во_ошибок = кол_во_ошибок + 1;
                }
            }
        } иначе {
            Собака tmp_s = новый Собака("Пес_" + i, i % 15, "Порода_" + i);
            сумма_возрастов = сумма_возрастов + tmp_s.возраст;
        }
        
        i = i + 1;
        
        если (i % 2000 == 0) {
            вывод "   ... обработано " + i + " объектов";
        }
    }
    
    вывод "";
    вывод "✓ Цикл завершен.";
    вывод "   Общая сумма возрастов: " + сумма_возрастов;
    вывод "   Количество ошибок целостности: " + кол_во_ошибок;
    
    если (кол_во_ошибок > 0) {
        вывод "⚠️ ВНИМАНИЕ: Обнаружены расхождения в данных!";
    } иначе {
        вывод "✅ Все данные сохранились корректно.";
    }
    
    // 5. Изоляция памяти
    вывод "";
    вывод "[ТЕСТ 5] Проверка изоляции памяти...";
    
    Кошка локальная_кошка = новый Кошка("Локал", 1, "Белый");
    текст имя_до = локальная_кошка.имя;
    
    // Модификация другого объекта
    Кошка временная = новый Кошка("Врем", 99, "Черный");
    временная.имя = "Изменено";
    
    если (локальная_кошка.имя == "Локал") {
        вывод "✓ Память объектов изолирована успешно.";
    } иначе {
        вывод "✗ КРИТИЧЕСКАЯ ОШИБКА: Утечка или пересечение памяти!";
    }
    
    вывод "";
    вывод "==========================================";
    вывод "   ИТОГ: ТЕСТ ЗАВЕРШЕН";
    вывод "==========================================";
}