функция главная() {
    вывод "=== Угадай число от 1 до 100 ===";
    целое загаданное = случайное(1, 100);
    целое попытки = 0;
    целое угадано = 0;
    
    пока (угадано == 0) {
        вывод "Твой вариант (0 = выход): ";
        целое ответ = в_число(ввод);
        
        если (ответ == 0) {
            вывод "Выход! Загадано было: " + загаданное;
            прервать;
        }
        
        попытки = попытки + 1;
        
        если (ответ < загаданное) {
            вывод "Больше!";
        } иначе_если (ответ > загаданное) {
            вывод "Меньше!";
        } иначе {
            вывод "Поздравляю! Угадал с " + попытки + " попытки!";
            угадано = 1;
        }
    }
}