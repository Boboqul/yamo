текст email = ввод();
текст parol = ввод();

текст forma = "email=" + email + "&password=" + parol;

текст javob = http_отправить(
    "https://mail.harakatda.com/api/login.php",
    forma,
    "POST"
);

если (javob == "") {
    вывод "API dan javob kelmadi.";
} иначе {

    словарь data = json_разобрать(javob);

    если (data["ok"] != истина) {
        вывод "Xato: " + data["error"];
    } иначе {

        текст token = data["token"];

        текст sentJavob = http_отправить(
            "https://mail.harakatda.com/api/sent.php",
            "",
            "GET",
            token
        );

        словарь sentData = json_разобрать(sentJavob);

        текст html = "
