        если (sentData["ok"] != истина) {

            html = html + "
<p>Xato: " + sentData["error"] + "</p>
";

        } иначе {

            массив messages = sentData["messages"];
            целое son = длина(messages);

            если (son == 0) {

                html = html + "
<p>Hozircha jo'natilgan xatlar yo'q.</p>
";

            } иначе {

                для (целое i = 0; i < son; i = i + 1) {

                    словарь msg = messages[i];

                    html = html + "
<div class='mail'>
<div class='subject'>" + msg["subject"] + "</div>
<div class='info'>Kimga: " + msg["to"] + "</div>
<div class='info'>Sana: " + msg["date"] + "</div>
</div>
";
                }
            }
        }

        html = html + "
</div>
</div>

</body>
</html>
";

        браузер_показать(html);
    }
}