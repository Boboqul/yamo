функция привет(текст имя) {
    вывод "Привет из ЯМО-в-ЯМО, " + имя + "!";
    целое l = длина(имя);
    вернуть l;
}

функция сумма_до(целое n) {
    целое s = 0;
    целое i = 1;
    пока (i <= n) {
        s = s + i;
        i = i + 1;
    }
    вернуть s;
}

функция главная() {
    целое n = привет("самохостинг");
    вывод "Длина: " + n;
    целое sum = сумма_до(10);
    вывод "Сумма до 10: " + sum;
    
    массив arr;
    arr = [1, 2, 3];
    добавить(arr, 4);
    вывод "Длина массива: " + длина(arr);
    
    вывод "Самохостинг работает!";
}