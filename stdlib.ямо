функция факториал(целое n) {
    если (n <= 1) { вернуть 1; }
    вернуть n * факториал(n - 1);
}

функция фибоначчи(целое n) {
    если (n <= 1) { вернуть n; }
    вернуть фибоначчи(n - 1) + фибоначчи(n - 2);
}

функция НОД(целое a, целое b) {
    пока (b != 0) {
        целое t = b;
        b = a % b;
        a = t;
    }
    вернуть a;
}

функция степень_целая(целое основание, целое показатель) {
    целое результат = 1;
    для (целое i = 0; i < показатель; i = i + 1) {
        результат = результат * основание;
    }
    вернуть результат;
}

функция является_простым(целое n) {
    если (n < 2) { вернуть ложь; }
    для (целое d = 2; d * d <= n; d = d + 1) {
        если (n % d == 0) { вернуть ложь; }
    }
    вернуть истина;
}

функция сумма_массива(целое arr) {
    целое сумма = 0;
    для (целое i = 0; i < длина(arr); i = i + 1) {
        сумма = сумма + arr[i];
    }
    вернуть сумма;
}

функция максимум_массива(целое arr) {
    целое максимум = arr[0];
    для (целое i = 1; i < длина(arr); i = i + 1) {
        если (arr[i] > максимум) { максимум = arr[i]; }
    }
    вернуть максимум;
}

функция минимум_массива(целое arr) {
    целое минимум = arr[0];
    для (целое i = 1; i < длина(arr); i = i + 1) {
        если (arr[i] < минимум) { минимум = arr[i]; }
    }
    вернуть минимум;
}