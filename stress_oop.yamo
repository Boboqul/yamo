// stress_oop_fixed.yamo — Исправленный стресс-тест ООП

// --- БАЗОВЫЙ КЛАСС ---
класс Фигура {
    текст цвет;
    
    функция инициализация(текст c) {
        этот.цвет = c;
    }
    
    функция площадь() {
        вернуть 0;
    }
    
    функция информация() {
        вернуть "Цвет: " + этот.цвет;
    }
}

// --- ДОЧЕРНИЙ КЛАСС 1: КРУГ ---
класс Круг : Фигура {
    дробное радиус;
    
    функция инициализация(текст c, дробное r) {
        этот.цвет = c; 
        этот.радиус = r;
    }
    
    функция площадь() {
        вернуть 3.14159 * этот.радиус * этот.радиус;
    }
}

// --- ДОЧЕРНИЙ КЛАСС 2: ПРЯМОУГОЛЬНИК ---
класс Прямоугольник : Фигура {
    целое ширина;
    целое высота;
    
    функция инициализация(текст c, целое w, целое h) {
        этот.цвет = c;
        этот.ширина = w;
        этот.высота = h;
    }
    
    функция площадь() {
        вернуть этот.ширина * этот.высота;
    }
}

// --- ДОПОЛНИТЕЛЬНЫЙ КЛАСС ДЛЯ ТЕСТА ВЫЧИСЛЕНИЙ ---
// Теперь он тоже глобальный!
класс Матрица {
    целое размер;
    
    функция инициализация(целое s) {
        этот.размер = s;
    }
    
    функция детерминант_эмуляция() {
        целое result = 1;
        целое j = 1;
        пока (j <= этот.размер) {
            result = result * j; // Факториал
            j = j + 1;
        }
        вернуть result;
    }
}

// --- ГЛАВНАЯ ЛОГИКА ТЕСТА ---
функция главная() {
    вывод "========================================";
    вывод "   ЗАПУСК ИСПРАВЛЕННОГО СТРЕСС-ТЕСТА";
    вывод "========================================";
    
    // 1. Проверка базовой функциональности
    вывод "";
    вывод "[ТЕСТ 1] Создание экземпляров разных классов...";
    
    Круг к1 = новый Круг("Красный", 5.0);
    вывод "Круг: Радиус=" + к1.радиус + ", Площадь=" + к1.площадь();
    
    Прямоугольник п1 = новый Прямоугольник("Синий", 4, 6);
    вывод "Прямоугольник: W=" + п1.ширина + ", H=" + п1.высота + ", Площадь=" + п1.площадь();
    
    // 2. Изоляция данных
    вывод "";
    вывод "[ТЕСТ 2] Изоляция данных между объектами...";
    
    Круг к2 = новый Круг("Зеленый", 2.0);
    к2.радиус = 10.0; 
    
    если (к1.радиус == 5.0) {
        вывод "✓ Данные изолированы успешно.";
    } иначе {
        вывод "✗ ОШИБКА: Данные пересеклись!";
    }
    
    // 3. Нагрузочный тест
    вывод "";
    вывод "[ТЕСТ 3] Нагрузочный тест: Создание 10,000 объектов...";
    
    целое сумма_площадей = 0;
    целое i = 0;
    
    пока (i < 10000) {
        если (i % 2 == 0) {
            Круг tmp_krug = новый Круг("Тест", i / 100.0);
            сумма_площадей = сумма_площадей + tmp_krug.площадь();
        } иначе {
            Прямоугольник tmp_rect = новый Прямоугольник("Тест", i, i + 1);
            сумма_площадей = сумма_площадей + tmp_rect.площадь();
        }
        
        i = i + 1;
        
        если (i % 2000 == 0) {
            вывод "   ... обработано " + i + " объектов";
        }
    }
    
    вывод "✓ Цикл завершен. Общая сумма площадей: " + сумма_площадей;
    
    // 4. Сложные вычисления (Матрица теперь доступна!)
    вывод "";
    вывод "[ТЕСТ 4] Работа с классом Матрица...";
    
    Матрица m = новый Матрица(10);
    вывод "Факториал(10) через объект Матрица: " + m.детерминант_эмуляция();
    
    вывод "";
    вывод "========================================";
    вывод "   ТЕСТ ЗАВЕРШЕН УСПЕШНО";
    вывод "========================================";
}