// test_oop.yamo — Проверка нативной поддержки ООП в ЯМО

класс Точка {
    целое x;
    целое y;

    // Конструктор
    функция инициализация(целое а, целое б) {
        этот.x = а;
        этот.y = б;
    }

    // Метод суммы координат
    функция сумма() {
        вернуть этот.x + этот.y;
    }

    // Метод расстояния до нуля (упрощенно, без корня для теста целых чисел)
    функция квадрат_расстояния() {
        вернуть этот.x * этот.x + этот.y * этот.y;
    }
}

функция главная() {
    вывод "=== ЗАПУСК ТЕСТА НАТИВНОГО ООП ===";

    // Создание объекта через ключевое слово 'новый'
    Точка т1 = новый Точка(3, 4);
    
    вывод "Координаты точки т1: (" + т1.x + ", " + т1.y + ")";
    вывод "Сумма координат: " + т1.сумма();
    вывод "Квадрат расстояния от начала координат: " + т1.квадрат_расстояния();

    // Второй объект
    Точка т2 = новый Точка(0, 5);
    вывод "";
    вывод "Координаты точки т2: (" + т2.x + ", " + т2.y + ")";
    вывод "Сумма координат т2: " + т2.сумма();

    вывод "";
    вывод "=== ТЕСТИРОВАНИЕ ЗАВЕРШЕНО ===";
}