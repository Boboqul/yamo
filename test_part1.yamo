класс ЖивоеСущество {
    текст имя;
    целое возраст;
    
    функция инициализация(текст n, целое a) {
        этот.имя = n;
        этот.возраст = a;
    }
}

класс Кошка : ЖивоеСущество {
    текст цвет_шерсти;
    
    функция инициализация(текст n, целое a, текст c) {
        этот.имя = n;
        этот.возраст = a;
        этот.цвет_шерсти = c;
    }
    
    функция мяукать() {
        вернуть "МЯУ!";
    }
}

функция главная() {
    вывод "=== ТЕСТ ЧАСТИ 1: СОЗДАНИЕ ОБЪЕКТОВ ===";
    
    Кошка к1 = новый Кошка("Барсик", 3, "Рыжий");
    вывод "Имя: " + к1.имя;
    вывод "Цвет: " + к1.цвет_шерсти;
    вывод "Звук: " + к1.мяукать();
    
    вывод "✅ Часть 1 успешна.";
}

главная();
