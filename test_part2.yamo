класс ЖивоеСущество {
    текст имя;
    целое возраст;
    
    функция инициализация(текст n, целое a) {
        этот.имя = n;
        этот.возраст = a;
    }
}

класс Кошка : ЖивоеСущество {
    функция инициализация(текст n, целое a) {
        этот.имя = n;
        этот.возраст = a;
    }
}

функция главная() {
    вывод "=== ТЕСТ ЧАСТИ 2: ЦИКЛ 5000 ОБЪЕКТОВ ===";
    
    целое сумма = 0;
    целое i = 0;
    
    пока (i < 5000) {
        Кошка tmp = новый Кошка("Кот_" + i, i % 10);
        сумма = сумма + tmp.возраст;
        i = i + 1;
        
        если (i % 1000 == 0) {
            вывод "   ... обработано " + i;
        }
    }
    
    вывод "✅ Часть 2 успешна. Сумма: " + сумма;
}

главная();
