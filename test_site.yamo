// test_site.yamo — Демонстрация работы Паутины

подключить паутина;

// Определяем обработчики
функция главная(req) {
    вернуть "<html><body>" +
           "<h1 style='color:green'>Добро пожаловать на сайт ЯМО!</h1>" +
           "<p>Это страница работает без единой строчки C++ кода в логике.</p>" +
           "<hr/>" +
           "<a href='/info'>Информация о сервере</a>" +
           "</body></html>";
}

функция инфо(req) {
    текст info_html = "<html><body><h1>Статистика</h1>" +
                      "<p>Версия ЯМО: 2026.10.05</p>" +
                      "<p>Режим: Self-Hosted Web Server</p>" +
                      "<a href='/'>Назад</a>" +
                      "</body></html>";
    вернуть info_html;
}

// Регистрируем маршруты
зарегистрировать("/", "главная");
зарегистрировать("/info", "инфо");

// Запускаем сервер на порту 8080
слушать(8080);
