функция пи() { вернуть 3.141592653589793; }
функция е()  { вернуть 2.718281828459045; }

функция градусы_в_радианы(дробное г) {
    вернуть г * пи() / 180.0;
}

// Тригонометрия в градусах (как в меню калькулятора)
функция синус(дробное градусы)   { вернуть синус_рад(градусы_в_радианы(градусы)); }
функция косинус(дробное градусы) { вернуть косинус_рад(градусы_в_радианы(градусы)); }
функция тангенс(дробное градусы) { вернуть тангенс_рад(градусы_в_радианы(градусы)); }
// Обратные тригонометрические функции (в градусах)
функция котангенс(дробное градусы) { вернуть котангенс_рад(градусы_в_радианы(градусы)); }
функция секанс(дробное градусы)    { вернуть секанс_рад(градусы_в_радианы(градусы)); }
функция косеканс(дробное градусы)  { вернуть косеканс_рад(градусы_в_радианы(градусы)); }

// Логарифмы по разным основаниям
функция логарифм10(дробное х) { вернуть логарифм(х) / логарифм(10.0); }
функция логарифм2(дробное х)  { вернуть логарифм(х) / логарифм(2.0); }