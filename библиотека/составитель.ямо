// составитель.ямо - парсер токенов в AST
// Состояние парсера хранится в словаре и передаётся через параметры

функция иниц_парсер(массив токены, словарь сост) {
    сост["токены"] = токены;
    сост["поз"] = 0;
}

функция текущий(словарь сост) {
    целое поз = сост["поз"];
    массив токены = сост["токены"];
    если (поз < длина(токены)) {
        словарь т;
        т = токены[поз];
        вернуть т;
    }
    словарь пуст;
    пуст["тип"] = "КОНЕЦ";
    пуст["значение"] = "";
    вернуть пуст;
}

функция следующий(словарь сост) {
    целое поз = сост["поз"];
    сост["поз"] = поз + 1;
}

функция тип_текущего(словарь сост) {
    словарь т = текущий(сост);
    вернуть т["тип"];
}

функция значение_текущего(словарь сост) {
    словарь т = текущий(сост);
    вернуть т["значение"];
}

// Первичные выражения: числа, строки, имена, логические, скобки
функция парсер_первичного(словарь сост) {
    текст тип = тип_текущего(сост);

    если (тип == "ЧИСЛО") {
        словарь узел;
        узел["тип"] = "ЛИТЕРАЛ_ЧИСЛО";
        узел["значение"] = значение_текущего(сост);
        следующий(сост);
        вернуть узел;
    }

    если (тип == "СТРОКА") {
        словарь узел;
        узел["тип"] = "ЛИТЕРАЛ_СТРОКА";
        узел["значение"] = значение_текущего(сост);
        следующий(сост);
        вернуть узел;
    }

    если (тип == "ИМЯ") {
        словарь т2 = токен_смещение(сост, 1);
        логическое вызов = ложь;
        если (т2["тип"] == "СИМВОЛ") {
            текст з2 = т2["значение"];
            если (з2 == "(") {
                вызов = истина;
            }
        }
        если (вызов) {
            текст имяф = значение_текущего(сост);
            следующий(сост);
            следующий(сост);
            массив аргументы = [];
            пока (истина) {
                текст т = тип_текущего(сост);
                если (т == "КОНЕЦ") {
                    прервать;
                }
                логическое конец = ложь;
                если (т == "СИМВОЛ") {
                    текст зн = значение_текущего(сост);
                    если (зн == ")") {
                        конец = истина;
                    }
                }
                если (конец) {
                    следующий(сост);
                    прервать;
                }
                словарь а = парсер_выражения(сост);
                добавить(аргументы, а);
                текст т3 = тип_текущего(сост);
                если (т3 == "СИМВОЛ") {
                    текст зн3 = значение_текущего(сост);
                    если (зн3 == ",") {
                        следующий(сост);
                    }
                }
            }
            словарь узелв;
            узелв["тип"] = "ВЫЗОВ";
            узелв["имя"] = имяф;
            узелв["аргументы"] = аргументы;
            вернуть парсер_индекс_хвост(сост, узелв);
        }
        словарь узел;
        узел["тип"] = "ПЕРЕМЕННАЯ";
        узел["имя"] = значение_текущего(сост);
        следующий(сост);
        вернуть парсер_индекс_хвост(сост, узел);
    }

    если (тип == "КЛЮЧ") {
        текст слово = значение_текущего(сост);
        если (слово == "истина") {
            словарь узел;
            узел["тип"] = "ЛИТЕРАЛ_ЛОГ";
            узел["значение"] = "истина";
            следующий(сост);
            вернуть узел;
        }
        если (слово == "ложь") {
            словарь узел;
            узел["тип"] = "ЛИТЕРАЛ_ЛОГ";
            узел["значение"] = "ложь";
            следующий(сост);
            вернуть узел;
        }
    }

    если (тип == "СИМВОЛ") {
        текст зн0 = значение_текущего(сост);
        если (зн0 == "[") {
            следующий(сост);
            массив элементы = [];
            пока (истина) {
                текст т = тип_текущего(сост);
                если (т == "КОНЕЦ") {
                    прервать;
                }
                логическое конец = ложь;
                если (т == "СИМВОЛ") {
                    текст з = значение_текущего(сост);
                    если (з == "]") {
                        конец = истина;
                    }
                }
                если (конец) {
                    следующий(сост);
                    прервать;
                }
                словарь э = парсер_выражения(сост);
                добавить(элементы, э);
                текст т3 = тип_текущего(сост);
                если (т3 == "СИМВОЛ") {
                    текст з3 = значение_текущего(сост);
                    если (з3 == ",") {
                        следующий(сост);
                    }
                }
            }
            словарь узелм;
            узелм["тип"] = "МАССИВ_ЛИТ";
            узелм["элементы"] = элементы;
            вернуть узелм;
        }
    }
    // Скобки: ( выражение )
    если (тип == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == "(") {
            следующий(сост);
            словарь внутр = парсер_выражения(сост);
            текст тип2 = тип_текущего(сост);
            если (тип2 == "СИМВОЛ") {
                текст зн2 = значение_текущего(сост);
                если (зн2 == ")") {
                    следующий(сост);
                }
            }
            вернуть внутр;
        }
    }

    словарь узел;
    узел["тип"] = "ОШИБКА";
    узел["сообщение"] = "Неожиданный токен: " + тип;
    вернуть узел;
}

// Умножение и деление (высокий приоритет)
функция парсер_умножения(словарь сост) {
    словарь левый = парсер_первичного(сост);

    пока (тип_текущего(сост) == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        логическое умн = ложь;
        логическое дел = ложь;
        если (зн == "*") { умн = истина; }
        если (зн == "/") { дел = истина; }
        если (умн) {
            следующий(сост);
            словарь правый = парсер_первичного(сост);
            словарь узел;
            узел["тип"] = "БИНАРНАЯ";
            узел["оп"] = "*";
            узел["левый"] = левый;
            узел["правый"] = правый;
            левый = узел;
        } иначе {
            если (дел) {
                следующий(сост);
                словарь правый = парсер_первичного(сост);
                словарь узел;
                узел["тип"] = "БИНАРНАЯ";
                узел["оп"] = "/";
                узел["левый"] = левый;
                узел["правый"] = правый;
                левый = узел;
            } иначе {
                прервать;
            }
        }
    }

    вернуть левый;
}

// Сложение и вычитание (низкий приоритет)
функция парсер_сложения(словарь сост) {
    словарь левый = парсер_умножения(сост);

    пока (тип_текущего(сост) == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        логическое плюс = ложь;
        логическое минус = ложь;
        если (зн == "+") { плюс = истина; }
        если (зн == "-") { минус = истина; }
        если (плюс) {
            следующий(сост);
            словарь правый = парсер_умножения(сост);
            словарь узел;
            узел["тип"] = "БИНАРНАЯ";
            узел["оп"] = "+";
            узел["левый"] = левый;
            узел["правый"] = правый;
            левый = узел;
        } иначе {
            если (минус) {
                следующий(сост);
                словарь правый = парсер_умножения(сост);
                словарь узел;
                узел["тип"] = "БИНАРНАЯ";
                узел["оп"] = "-";
                узел["левый"] = левый;
                узел["правый"] = правый;
                левый = узел;
            } иначе {
                прервать;
            }
        }
    }

    вернуть левый;
}

// Сравнение: ==, !=, <, >, <=, >=
функция парсер_сравнения(словарь сост) {
    словарь левый = парсер_сложения(сост);

    пока (истина) {
        текст тип = тип_текущего(сост);
        логическое есть_оп = ложь;
        текст оп = "";
        если (тип == "ОПЕРАТОР") {
            оп = значение_текущего(сост);
            есть_оп = истина;
        }
        если (тип == "СИМВОЛ") {
            текст зн = значение_текущего(сост);
            если (зн == "<") { оп = "<"; есть_оп = истина; }
            если (зн == ">") { оп = ">"; есть_оп = истина; }
        }
        если (есть_оп) {
            следующий(сост);
            словарь правый = парсер_сложения(сост);
            словарь узел;
            узел["тип"] = "БИНАРНАЯ";
            узел["оп"] = оп;
            узел["левый"] = левый;
            узел["правый"] = правый;
            левый = узел;
        } иначе {
            прервать;
        }
    }

    вернуть левый;
}

// Полное выражение
функция парсер_выражения(словарь сост) {
    вернуть парсер_сравнения(сост);
}

// Присваивание: имя = выражение
функция парсер_присваивания(словарь сост) {
    словарь имя_узел = парсер_выражения(сост);

    текст тип = тип_текущего(сост);
    если (тип == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == "=") {
            следующий(сост);
            словарь знач = парсер_выражения(сост);
            словарь узел;
            узел["тип"] = "ПРИСВАИВАНИЕ";
            узел["цель"] = имя_узел;
            узел["значение"] = знач;
            вернуть узел;
        }
    }

    вернуть имя_узел;
}

// Точка входа: разбирает программу из токенов
функция составить(массив токены, словарь результат) {
    целое прогресс = 0;
    текст отл = "отл_парс";
    словарь отладка;
    отладка["всего"] = длина(токены);
    отладка["текущий"] = 0;
    результат[отл] = отладка;
    словарь сост;
    иниц_парсер(токены, сост);
    массив узлы = [];

    целое счётчик = 0;
    целое след_печать = 100;
    пока (тип_текущего(сост) != "КОНЕЦ") {
        целое поз_до = сост["поз"];
        словарь узел = парсер_оператора(сост);
        добавить(узлы, узел);
        счётчик = счётчик + 1;
        если (счётчик >= след_печать) {
            вывод "ПРОГРЕСС: " + счётчик + " узлов, поз=" + сост["поз"];
            след_печать = след_печать + 100;
        }
        если (сост["поз"] == поз_до) {
            следующий(сост);
        }
    }

    результат["узлы"] = узлы;
}

// Токен со смещением (заглядывание вперёд)
функция токен_смещение(словарь сост, целое см) {
    целое поз = сост["поз"];
    целое целевая = поз + см;
    массив токены = сост["токены"];
    если (целевая < длина(токены)) {
        словарь т;
        т = токены[целевая];
        вернуть т;
    }
    словарь пуст;
    пуст["тип"] = "КОНЕЦ";
    пуст["значение"] = "";
    вернуть пуст;
}

// Функция: функция имя(параметры) { тело }
функция парсер_индекс_хвост(словарь сост, словарь база) {
    пока (истина) {
        текст тт = тип_текущего(сост);
        логическое есть = ложь;
        если (тт == "СИМВОЛ") {
            текст зз = значение_текущего(сост);
            если (зз == "[") {
                есть = истина;
            }
        }
        если (есть) {
            следующий(сост);
            словарь ид = парсер_выражения(сост);
            текст т2 = тип_текущего(сост);
            если (т2 == "СИМВОЛ") {
                текст з2 = значение_текущего(сост);
                если (з2 == "]") {
                    следующий(сост);
                }
            }
            словарь ин;
            ин["тип"] = "ИНДЕКС";
            ин["база"] = база;
            ин["индекс"] = ид;
            база = ин;
        } иначе {
            прервать;
        }
    }
    вернуть база;
}
функция парсер_функции(словарь сост) {
    следующий(сост);
    текст имя = значение_текущего(сост);
    следующий(сост);

    массив параметры = [];
    текст т0 = тип_текущего(сост);
    если (т0 == "СИМВОЛ") {
        текст з0 = значение_текущего(сост);
        если (з0 == "(") {
            следующий(сост);
        }
    }

    пока (истина) {
        текст т = тип_текущего(сост);
        если (т == "КОНЕЦ") {
            прервать;
        }
        логическое конец = ложь;
        если (т == "СИМВОЛ") {
            текст зн = значение_текущего(сост);
            если (зн == ")") {
                конец = истина;
            }
        }
        если (конец) {
            следующий(сост);
            прервать;
        }
        словарь т1 = текущий(сост);
        если (т1["тип"] == "КЛЮЧ") {
            следующий(сост);
        }
        текст имяп = значение_текущего(сост);
        добавить(параметры, имяп);
        следующий(сост);
        текст т3 = тип_текущего(сост);
        если (т3 == "СИМВОЛ") {
            текст зн3 = значение_текущего(сост);
            если (зн3 == ",") {
                следующий(сост);
            }
        }
    }

    словарь тело = парсер_блока(сост);

    словарь узел;
    узел["тип"] = "ФУНКЦИЯ";
    узел["имя"] = имя;
    узел["параметры"] = параметры;
    узел["тело"] = тело;
    вернуть узел;
}

// Вернуть: вернуть выражение
функция парсер_вернуть(словарь сост) {
    следующий(сост);
    словарь знач = парсер_выражения(сост);
    словарь узел;
    узел["тип"] = "ВЕРНУТЬ";
    узел["значение"] = знач;
    вернуть узел;
}
// Блок: { операторы }
функция парсер_блока(словарь сост) {
    массив операторы = [];

    текст тип = тип_текущего(сост);
    если (тип == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == "{") {
            следующий(сост);
        }
    }

    пока (истина) {
        текст т = тип_текущего(сост);
        если (т == "КОНЕЦ") {
            прервать;
        }
        если (т == "СИМВОЛ") {
            текст з0 = значение_текущего(сост);
            если (з0 == ";") {
                следующий(сост);
                продолжить;
            }
        }
        логическое конец_блока = ложь;
        если (т == "СИМВОЛ") {
            текст зн = значение_текущего(сост);
            если (зн == "}") {
                конец_блока = истина;
            }
        }
        если (конец_блока) {
            следующий(сост);
            прервать;
        }
        словарь оп = парсер_оператора(сост);
        добавить(операторы, оп);
    }

    словарь узел;
    узел["тип"] = "БЛОК";
    узел["операторы"] = операторы;
    вернуть узел;
}

// Если: если (условие) блок иначе блок
функция парсер_если(словарь сост) {
    следующий(сост);

    текст тип = тип_текущего(сост);
    если (тип == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == "(") {
            следующий(сост);
        }
    }

    словарь условие = парсер_выражения(сост);

    текст тип2 = тип_текущего(сост);
    если (тип2 == "СИМВОЛ") {
        текст зн2 = значение_текущего(сост);
        если (зн2 == ")") {
            следующий(сост);
        }
    }

    словарь тело = парсер_блока(сост);

    словарь иначе_тело;
    иначе_тело["тип"] = "ПУСТО";

    текст тип3 = тип_текущего(сост);
    если (тип3 == "КЛЮЧ") {
        текст слово = значение_текущего(сост);
        если (слово == "иначе") {
            следующий(сост);
            иначе_тело = парсер_блока(сост);
        }
    }

    словарь узел;
    узел["тип"] = "ЕСЛИ";
    узел["условие"] = условие;
    узел["тело"] = тело;
    узел["иначе"] = иначе_тело;
    вернуть узел;
}

// Пока: пока (условие) блок
функция парсер_пока(словарь сост) {
    следующий(сост);

    текст тип = тип_текущего(сост);
    если (тип == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == "(") {
            следующий(сост);
        }
    }

    словарь условие = парсер_выражения(сост);

    текст тип2 = тип_текущего(сост);
    если (тип2 == "СИМВОЛ") {
        текст зн2 = значение_текущего(сост);
        если (зн2 == ")") {
            следующий(сост);
        }
    }

    словарь тело = парсер_блока(сост);

    словарь узел;
    узел["тип"] = "ПОКА";
    узел["условие"] = условие;
    узел["тело"] = тело;
    вернуть узел;
}

// Вывод: вывод выражение ;
функция парсер_вывод(словарь сост) {
    следующий(сост);
    словарь знач = парсер_выражения(сост);
    текст т = тип_текущего(сост);
    если (т == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == ";") {
            следующий(сост);
        }
    }
    словарь узел;
    узел["тип"] = "ВЫВОД";
    узел["значение"] = знач;
    вернуть узел;
}

// Объявление: целое x = 5 ; или текст s = "hi" ;
функция парсер_объявления(словарь сост, текст тип_перем) {
    следующий(сост);
    текст имя = значение_текущего(сост);
    следующий(сост);

    словарь знач;
    знач["тип"] = "ПУСТО";

    текст тип = тип_текущего(сост);
    если (тип == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == "=") {
            следующий(сост);
            знач = парсер_выражения(сост);
        }
    }

    текст т3 = тип_текущего(сост);
    если (т3 == "СИМВОЛ") {
        текст зн3 = значение_текущего(сост);
        если (зн3 == ";") {
            следующий(сост);
        }
    }
    словарь узел;
    узел["тип"] = "ОБЪЯВЛЕНИЕ";
    узел["тип_перем"] = тип_перем;
    узел["имя"] = имя;
    узел["значение"] = знач;
    вернуть узел;
}

// Диспетчер операторов
функция парсер_оператора(словарь сост) {
    текст тип = тип_текущего(сост);

    если (тип == "КЛЮЧ") {
        текст слово = значение_текущего(сост);
        если (слово == "если") {
            вернуть парсер_если(сост);
        }
        если (слово == "функция") {
            вернуть парсер_функции(сост);
        }
        если (слово == "вернуть") {
            вернуть парсер_вернуть(сост);
        }
        если (слово == "прервать") {
            следующий(сост);
            текст тп = тип_текущего(сост);
            если (тп == "СИМВОЛ") {
                текст зп = значение_текущего(сост);
                если (зп == ";") {
                    следующий(сост);
                }
            }
            словарь узелп;
            узелп["тип"] = "ПРЕРВАТЬ";
            вернуть узелп;
        }
        если (слово == "продолжить") {
            следующий(сост);
            текст тп = тип_текущего(сост);
            если (тп == "СИМВОЛ") {
                текст зп = значение_текущего(сост);
                если (зп == ";") {
                    следующий(сост);
                }
            }
            словарь узелп;
            узелп["тип"] = "ПРОДОЛЖИТЬ";
            вернуть узелп;
        }
        если (слово == "словарь") {
            вернуть парсер_объявления(сост, "словарь");
        }
        если (слово == "массив") {
            вернуть парсер_объявления(сост, "массив");
        }
        если (слово == "пока") {
            вернуть парсер_пока(сост);
        }
        если (слово == "вывод") {
            вернуть парсер_вывод(сост);
        }
        если (слово == "целое") {
            вернуть парсер_объявления(сост, "целое");
        }
        если (слово == "дробное") {
            вернуть парсер_объявления(сост, "дробное");
        }
        если (слово == "текст") {
            вернуть парсер_объявления(сост, "текст");
        }
        если (слово == "логическое") {
            вернуть парсер_объявления(сост, "логическое");
        }
    }

    словарь узел = парсер_присваивания(сост);

    текст тип2 = тип_текущего(сост);
    если (тип2 == "СИМВОЛ") {
        текст зн2 = значение_текущего(сост);
        если (зн2 == ";") {
            следующий(сост);
        }
    }

    вернуть узел;
}

// Печать блоков и операторов// Печать AST для отладки
функция печать_узла(словарь узел, целое глубина) {
    текст отступ = "";
    целое i = 0;
    пока (i < глубина) {
        отступ = отступ + "  ";
        i = i + 1;
    }

    текст тип = узел["тип"];

    если (тип == "ЛИТЕРАЛ_ЧИСЛО") {
        вывод отступ + "ЧИСЛО: " + узел["значение"];
    }
    если (тип == "ЛИТЕРАЛ_СТРОКА") {
        вывод отступ + "СТРОКА: " + узел["значение"];
    }
    если (тип == "ЛИТЕРАЛ_ЛОГ") {
        вывод отступ + "ЛОГ: " + узел["значение"];
    }
    если (тип == "ПЕРЕМЕННАЯ") {
        вывод отступ + "ПЕРЕМЕННАЯ: " + узел["имя"];
    }
    если (тип == "БИНАРНАЯ") {
        вывод отступ + "БИНАРНАЯ [" + узел["оп"] + "]";
        словарь л;
        л = узел["левый"];
        печать_узла(л, глубина + 1);
        словарь п;
        п = узел["правый"];
        печать_узла(п, глубина + 1);
    }
    если (тип == "ПРИСВАИВАНИЕ") {
        вывод отступ + "ПРИСВАИВАНИЕ";
        словарь ц;
        ц = узел["цель"];
        печать_узла(ц, глубина + 1);
        словарь з;
        з = узел["значение"];
        печать_узла(з, глубина + 1);
    }
    если (тип == "ОШИБКА") {
        вывод отступ + "ОШИБКА: " + узел["сообщение"];
    }
    если (тип == "ФУНКЦИЯ") {
        вывод отступ + "ФУНКЦИЯ: " + узел["имя"];
        массив пр;
        пр = узел["параметры"];
        вывод отступ + "  параметры: " + длина(пр);
        словарь т;
        т = узел["тело"];
        печать_узла(т, глубина + 1);
    }
    если (тип == "ВЫЗОВ") {
        вывод отступ + "ВЫЗОВ: " + узел["имя"];
        массив ар;
        ар = узел["аргументы"];
        целое j = 0;
        пока (j < длина(ар)) {
            словарь а;
            а = ар[j];
            печать_узла(а, глубина + 1);
            j = j + 1;
        }
    }
    если (тип == "ВЕРНУТЬ") {
        вывод отступ + "ВЕРНУТЬ:";
        словарь з;
        з = узел["значение"];
        печать_узла(з, глубина + 1);
    }
    если (тип == "БЛОК") {
        вывод отступ + "БЛОК:";
        массив опс;
        опс = узел["операторы"];
        целое j = 0;
        пока (j < длина(опс)) {
            словарь о;
            о = опс[j];
            печать_узла(о, глубина + 1);
            j = j + 1;
        }
    }
    если (тип == "ЕСЛИ") {
        вывод отступ + "ЕСЛИ:";
        вывод отступ + "  условие:";
        словарь у;
        у = узел["условие"];
        печать_узла(у, глубина + 2);
        вывод отступ + "  тело:";
        словарь т;
        т = узел["тело"];
        печать_узла(т, глубина + 2);
        словарь блк;
        блк = узел["иначе"];
        если (блк["тип"] != "ПУСТО") {
            вывод отступ + "  иначе:";
            печать_узла(блк, глубина + 2);
        }
    }
    если (тип == "ПОКА") {
        вывод отступ + "ПОКА:";
        вывод отступ + "  условие:";
        словарь у;
        у = узел["условие"];
        печать_узла(у, глубина + 2);
        вывод отступ + "  тело:";
        словарь т;
        т = узел["тело"];
        печать_узла(т, глубина + 2);
    }
    если (тип == "ВЫВОД") {
        вывод отступ + "ВЫВОД:";
        словарь з;
        з = узел["значение"];
        печать_узла(з, глубина + 1);
    }
    если (тип == "ОБЪЯВЛЕНИЕ") {
        вывод отступ + "ОБЪЯВЛЕНИЕ " + узел["тип_перем"] + " " + узел["имя"];
        словарь з;
        з = узел["значение"];
        если (з["тип"] != "ПУСТО") {
            печать_узла(з, глубина + 1);
        }
    }
}

функция печать_ast(массив узлы) {
    целое i = 0;
    пока (i < длина(узлы)) {
        словарь узел;
        узел = узлы[i];
        вывод "--- узел " + (i + 1) + " ---";
        печать_узла(узел, 0);
        i = i + 1;
    }
}