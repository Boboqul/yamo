функция запустить_сервер(целое порт) {
    вывод "==========================================";
    вывод "   🕸️ ПАУТИНА ЯМО v2 (STATIC READY)";
    вывод "==========================================";
    
    словарь маршруты;
    маршруты["/"] = "главная_страница";
    маршруты["/about"] = "о_проекте";
    маршруты["/time"] = "показать_время";
    
    целое мастер_сокета = сеть_открыть(порт);
    вывод "[INFO] Сервер запущен на http://localhost:" + порт;
    
    пока (истина) {
        целое клиент_сокета = сеть_принять(мастер_сокета);
        текст сырые_данные = сеть_прочитать(клиент_сокета, 4096);
        
        если (сырые_данные != "") {
            словарь req = разобрать_http(сырые_данные);
            текст путь = req["путь"];
            
            вывод "[LOG] Запрос: " + req["метод"] + " " + путь;
            
            // 1. Защита от Directory Traversal
            если (содержит(путь, "..")) {
                сеть_написать(клиент_сокета, "HTTP/1.1 403 Forbidden\r\n\r\n");
                сеть_закрыть(клиент_сокета);
                продолжить;
            }

            // 2. ПРЯМАЯ ПРОВЕРКА СТАТИКИ
            если (содержит(путь, ".css") или содержит(путь, ".js") или содержит(путь, ".png") или содержит(путь, ".jpg") или содержит(путь, ".ico") или содержит(путь, ".html")) {
                
                // ИСПРАВЛЕНИЕ: Умное формирование пути без дублирования "static/"
                текст полный_путь_файла = "";
                если (содержит(путь, "/static/")) {
                    // Если путь уже /static/style.css, просто убираем первый слэш -> static/style.css
                    полный_путь_файла = часть(путь, 1, длина(путь));
                } иначе {
                    // Если путь /style.css, добавляем папку -> static/style.css
                    полный_путь_файла = "static/" + часть(путь, 1, длина(путь));
                }
                
                вывод "[LOG] Попытка отдать статику: " + полный_путь_файла;
                
                если (существует_файл(полный_путь_файла)) {
                    текст содержимое = читать_файл(полный_путь_файла);
                    
                    текст mime = "text/plain";
                    если (содержит(полный_путь_файла, ".css")) { mime = "text/css"; }
                    если (содержит(полный_путь_файла, ".js")) { mime = "application/javascript"; }
                    если (содержит(полный_путь_файла, ".html")) { mime = "text/html"; }
                    если (содержит(полный_путь_файла, ".png")) { mime = "image/png"; }
                    если (содержит(полный_путь_файла, ".jpg") или содержит(полный_путь_файла, ".jpeg")) { mime = "image/jpeg"; }
                    если (содержит(полный_путь_файла, ".ico")) { mime = "image/x-icon"; }
                    
                    текст ответ = собрать_http_ответ(200, mime, содержимое);
                    сеть_написать(клиент_сокета, ответ);
                    вывод "[LOG] Статика отправлена успешно.";
                } иначе {
                    вывод "[WARN] Файл не найден: " + полный_путь_файла;
                    сеть_написать(клиент_сокета, "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\n\r\nFile missing: " + полный_путь_файла);
                }
                
                сеть_закрыть(клиент_сокета);
                продолжить;
            }

            // 3. МАРШРУТИЗАЦИЯ ДИНАМИЧЕСКИХ СТРАНИЦ
            логическое найден = содержит_ключ(маршруты, путь);
            
            если (найден) {
                текст имя_функции = маршруты[путь];
                вывод "[LOG] Вызов обработчика: " + имя_функции;
                
                текст код_вызова = имя_функции + "(req)";
                текст ответ_тело = выполнить(код_вызова);
                
                текст полный_ответ = собрать_http_ответ(200, "text/html", ответ_тело);
                сеть_написать(клиент_сокета, полный_ответ);
            } иначе {
                текст страница_ошибки = "<html><body><h1>404 Страница не найдена</h1><p>Маршрут '" + путь + "' не существует.</p><a href='/'>На главную</a></body></html>";
                текст полный_ответ = собрать_http_ответ(404, "text/html", страница_ошибки);
                сеть_написать(клиент_сокета, полный_ответ);
            }
        }
        
        сеть_закрыть(клиент_сокета);
    }
}

запустить_сервер(8080);