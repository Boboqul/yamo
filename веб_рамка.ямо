функция разобрать_http(текст сырые_данные) {
    массив линии = разделить(сырые_данные, "\r\n");
    словарь запрос;
    
    если (длина(линии) == 0) {
        запрос["метод"] = "GET";
        запрос["путь"] = "/";
        вернуть запрос;
    }

    текст первая_строка = линии[0];
    массив части = разделить(первая_строка, " ");
    
    запрос["метод"] = части[0];
    запрос["путь"] = части[1];
    вернуть запрос;
}

функция собрать_http_ответ(целое статус, текст контент_тип, текст тело) {
    текст заголовки = "HTTP/1.1 " + в_текст(статус) + " OK\r\nContent-Type: " + контент_тип + "; charset=utf-8\r\nContent-Length: " + в_текст(длина(тело)) + "\r\nConnection: close\r\n\r\n";
    вернуть заголовки + тело;
}

функция главная_страница(словарь req) {
    текст css_link = "<link rel='stylesheet' href='/static/style.css'>";
    текст js_script = "<script src='/static/app.js'></script>";
    
    текст html = "<html><head>" + css_link + "</head><body>" +
           "<h1>🌐 Добро пожаловать в Паутину ЯМО!</h1>" +
           "<p>Этот сайт работает на чистом русском коде.</p>" +
           "<hr/>" +
           "<ul>" +
           "<li><a href='/about'>О проекте</a></li>" +
           "<li><a href='/time'>Текущее время</a></li>" +
           "</ul>" +
           js_script +
           "</body></html>";
    вернуть html;
}

