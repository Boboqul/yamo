// веб_сервер.ямо — Простейший HTTP-сервер на чистом ЯМО

функция обработать_запрос(целое соединение) {
    текст запрос = сокет_прочитать(соединение);
    
    если (запрос == "") {
        сокет_закрыть(соединение);
        вернуть;
    }
    
    // Разбираем первую строку: GET /path HTTP/1.1
    массив линии = разделить(запрос, "\n");
    текст первая_строка = линии[0];
    массив части = разделить(первая_строка, " ");
    
    текст метод = части[0];
    текст путь = части[1];
    
    вывод "📥 Запрос: " + метод + " " + путь;
    
    текст ответ_html = "";
    текст заголовок = "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\n";
    
    если (путь == "/") {
        ответ_html = "<html><body>" +
                      "<h1 style='color:green'>Привет от ЯМО!</h1>" +
                      "<p>Этот сервер работает полностью на русском языке.</p>" +
                      "<hr/>" +
                      "<a href='/time'>Показать время</a>" +
                      "</body></html>";
    } иначе_если (путь == "/time") {
        // Эмуляция времени (так как у нас нет системного вызова time пока)
        ответ_html = "<html><body><h1>Время сервера:</h1><p>Сейчас обрабатывается запрос...</p></body></html>";
    } иначе {
        заголовок = "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\n";
        ответ_html = "Страница не найдена: " + путь;
    }
    
    // Отправляем заголовки + длина тела + тело
    текст полный_ответ = заголовок + "Content-Length: " + в_текст(длина(ответ_html)) + "\r\n\r\n" + ответ_html;
    
    сокет_написать(соединение, полный_ответ);
    сокет_закрыть(соединение);
}

функция запустить_сервер(целое порт) {
    вывод "🚀 Запуск веб-сервера ЯМО на порту " + порт;
    вывод "Открой браузер и перейди на http://localhost:" + порт;
    
    целое мастер_сокета = сокет_слушать(порт);
    
    пока (истина) {
        целое клиент_сокета = сокет_принять(мастер_сокета);
        
        // Обработка синхронно (для MVP)
        обработать_запрос(клиент_сокета);
    }
}

// Точка входа
вывод "=== ВЕБ-СЕРВЕР ЯМО ===";
запустить_сервер(8080);