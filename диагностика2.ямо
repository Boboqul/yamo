    }

    если (тип == "ИНДЕКС") {
        словарь база = вычислить_аст(узел["база"], среда, рег);
        словарь индекс = вычислить_аст(узел["индекс"], среда, рег);
        если (база["т"] == "словарь") {
            словарь м;
            м = база["з"];
            текст ключ = воз_текст(индекс);
            словарь зв;
            зв = м[ключ];
            вернуть зв;
        }
        если (база["т"] == "массив") {
            массив м;
            м = база["з"];
            целое поз = воз_число(индекс);
            словарь зв;
            зв = м[поз];
            вернуть зв;
        }
        вернуть знач_число(0);
    }

    если (тип == "МАССИВ_ЛИТ") {
        массив рез = [];
        массив эл;
        эл = узел["элементы"];
        целое i = 0;
        пока (i < длина(эл)) {
            словарь э;
            э = эл[i];
            словарь зв = вычислить_аст(э, среда, рег);
            добавить(рез, зв);
            i = i + 1;
        }
        вернуть знач_массив(рез);
    }

    если (тип == "ВЫЗОВ") {
        текст имя = узел["имя"];
        массив арг_узлы;
        арг_узлы = узел["аргументы"];

        массив знач_арг = [];
        целое i = 0;
        пока (i < длина(арг_узлы)) {
            словарь ау;
            ау = арг_узлы[i];
            словарь зв = вычислить_аст(ау, среда, рег);
            добавить(знач_арг, зв);
            i = i + 1;
        }

        // --- ВСТРОЕННЫЕ ФУНКЦИИ (до поиска в фд!) ---

        если (имя == "длина") {
            словарь б1;
            б1 = знач_арг[0];
            если (б1["т"] == "текст") {
                вернуть знач_число(длина(б1["з"]));
            }
            если (б1["т"] == "массив") {
                вернуть знач_число(длина(б1["з"]));
            }
            вернуть знач_число(0);
        }

        если (имя == "часть") {
            словарь б1;
            б1 = знач_арг[0];
            словарь б2;
            б2 = знач_арг[1];
            словарь б3;
            б3 = знач_арг[2];
            текст ст;
            ст = б1["з"];
            целое нач = воз_число(б2);
            целое кон = воз_число(б3);
            вернуть знач_текст(часть(ст, нач, кон));
        }

        если (имя == "добавить") {
            словарь б1;
            б1 = знач_арг[0];
            словарь б2;
            б2 = знач_арг[1];
            массив м;
            м = б1["з"];
            добавить(м, б2);
            вернуть знач_число(0);
        }

        если (имя == "символ_из_кода") {
            словарь б1;
            б1 = знач_арг[0];
            целое код = воз_число(б1);
            вернуть знач_текст(символ_из_кода(код));
        }

        если (имя == "в_число") {
            словарь б1;
            б1 = знач_арг[0];
            вернуть знач_число(воз_число(б1));
        }

        если (имя == "в_текст") {
            словарь б1;
            б1 = знач_арг[0];
            вернуть знач_текст(воз_текст(б1));
        }

        если (имя == "тип_значения") {
            словарь б1;
            б1 = знач_арг[0];
            вернуть знач_текст(б1["т"]);
        }

        если (имя == "читать_файл") {
            словарь б1;
            б1 = знач_арг[0];
            текст путь;
            путь = б1["з"];
            вернуть знач_текст(читать_файл(путь));
        }

        если (имя == "код_символа") {
            словарь б1;
            б1 = знач_арг[0];
            текст с;
            с = б1["з"];
            вернуть знач_число(код_символа(с));
        }

        // --- ПОЛЬЗОВАТЕЛЬСКАЯ ФУНКЦИЯ ---

        словарь фд;
        фд = рег["функт"];
        словарь ф;
        ф = фд[имя];
        массив пр;
        пр = ф["параметры"];

        словарь гл;
        гл = рег["глубины"];
        целое ч;
        ч = воз_число(гл[имя]);
        гл[имя] = знач_число(ч + 1);

        словарь сох;
        сох = рег["сохранения"];
        целое k = 0;
        пока (k < длина(пр)) {
            текст имя_п;
            имя_п = пр[k];
            текст ключ;
            ключ = имя + "@" + имя_п + "@" + в_текст(ч);
            словарь старое;
            старое = среда[имя_п];
            сох[ключ] = старое;
            словарь ав;
            ав = знач_арг[k];
            среда[имя_п] = ав;
            k = k + 1;
        }

        словарь упр;
        упр["флаг"] = ложь;
        упр["значение"] = знач_число(0);
        упр["прервать"] = ложь;
        упр["продолжить"] = ложь;

        словарь тело;
        тело = ф["тело"];
        исполнить_блок_функции(тело, среда, рег, упр);

        целое k2 = 0;
        пока (k2 < длина(пр)) {
            текст имя_п;
            имя_п = пр[k2];
            текст ключ;
            ключ = имя + "@" + имя_п + "@" + в_текст(ч);
            словарь старое;
            старое = сох[ключ];
            среда[имя_п] = старое;
            k2 = k2 + 1;
        }
        гл[имя] = знач_число(ч);

        словарь резв;
        резв = упр["значение"];
        вернуть резв;
    }

    если (тип == "БИНАРНАЯ") {
        текст оп = узел["оп"];
        словарь лу;
        лу = узел["левый"];
        словарь пу;
        пу = узел["правый"];
        словарь лв = вычислить_аст(лу, среда, рег);
        словарь пв = вычислить_аст(пу, среда, рег);

        логическое л_текст = ложь;
        если (лв["т"] == "текст") { л_текст = истина; }
        логическое п_текст = ложь;
        если (пв["т"] == "текст") { п_текст = истина; }

        если (оп == "+") {
            если (л_текст) {
                вернуть знач_текст(воз_текст(лв) + воз_текст(пв));
            }
            если (п_текст) {
                вернуть знач_текст(воз_текст(лв) + воз_текст(пв));
            }
            вернуть знач_число(воз_число(лв) + воз_число(пв));
        }
        если (оп == "-") {
            вернуть знач_число(воз_число(лв) - воз_число(пв));
        }
        если (оп == "*") {
            вернуть знач_число(воз_число(лв) * воз_число(пв));
        }
        если (оп == "/") {
            вернуть знач_число(воз_число(лв) / воз_число(пв));
        }
        если (оп == "==") {
            если (л_текст) {
                вернуть знач_лог(воз_текст(лв) == воз_текст(пв));
            }
            если (п_текст) {
                вернуть знач_лог(воз_текст(лв) == воз_текст(пв));
            }
            вернуть знач_лог(воз_число(лв) == воз_число(пв));
        }
        если (оп == "<") {
            если (л_текст) {
                вернуть знач_лог(воз_текст(лв) < воз_текст(пв));
            }
            вернуть знач_лог(воз_число(лв) < воз_число(пв));
        }
        если (оп == ">") {
            если (л_текст) {
                вернуть знач_лог(воз_текст(лв) > воз_текст(пв));
            }
            вернуть знач_лог(воз_число(лв) > воз_число(пв));
        }
        если (оп == "<=") {
            если (л_текст) {
                вернуть знач_лог(воз_текст(лв) <= воз_текст(пв));
            }
            вернуть знач_лог(воз_число(лв) <= воз_число(пв));
        }
        если (оп == ">=") {
            если (л_текст) {
                вернуть знач_лог(воз_текст(лв) >= воз_текст(пв));
            }
            вернуть знач_лог(воз_число(лв) >= воз_число(пв));
        }
        вернуть знач_число(0);
    }

    вернуть знач_число(0);
}

// ===== ИСПОЛНЕНИЕ ОПЕРАТОРОВ =====

функция исполнить_узел(словарь узел, словарь среда, словарь рег, словарь упр) {
    текст тип = узел["тип"];

    если (тип == "ФУНКЦИЯ") {
        вернуть 0;
    }

    если (тип == "ОБЪЯВЛЕНИЕ") {
        текст имя = узел["имя"];
        текст тп = узел["тип_перем"];
        словарь зу;
        зу = узел["значение"];
        если (зу["тип"] == "ПУСТО") {
            если (тп == "словарь") {
                словарь м;
                среда[имя] = знач_словарь(м);
            } иначе {
                если (тп == "массив") {
                    массив м;
                    среда[имя] = знач_массив(м);
                } иначе {
                    если (тп == "текст") {
                        среда[имя] = знач_текст("");
                    } иначе {
                        если (тп == "логическое") {
                            среда[имя] = знач_лог(ложь);
                        } иначе {
                            среда[имя] = знач_число(0);
                        }
                    }
                }
            }
        } иначе {
            словарь зв = вычислить_аст(зу, среда, рег);
            среда[имя] = зв;
        }
        вернуть 0;
    }

    если (тип == "ПРИСВАИВАНИЕ") {
        словарь ц;
        ц = узел["цель"];
        словарь зу;
        зу = узел["значение"];
        словарь зв = вычислить_аст(зу, среда, рег);
        если (ц["тип"] == "ПЕРЕМЕННАЯ") {
            текст имя = ц["имя"];
            среда[имя] = зв;
        } иначе {
            если (ц["тип"] == "ИНДЕКС") {
                словарь база = вычислить_аст(ц["база"], среда, рег);
                словарь индекс = вычислить_аст(ц["индекс"], среда, рег);
                если (база["т"] == "словарь") {
                    словарь м;
                    м = база["з"];
                    текст ключ = воз_текст(индекс);
                    м[ключ] = зв;
                } иначе {
                    если (база["т"] == "массив") {
                        массив м;
                        м = база["з"];
                        целое поз = воз_число(индекс);
                        м[поз] = зв;
                    }
                }
            }
        }
        вернуть 0;
    }

    если (тип == "ВЫВОД") {
        словарь зу;
        зу = узел["значение"];
        словарь зв = вычислить_аст(зу, среда, рег);
        вывод воз_текст(зв);
        вернуть 0;
    }

    если (тип == "ВЕРНУТЬ") {
        словарь зу;
        зу = узел["значение"];
        словарь зв = вычислить_аст(зу, среда, рег);
        упр["флаг"] = истина;
        упр["значение"] = зв;
        вернуть 0;
    }

    если (тип == "ПРЕРВАТЬ") {
        упр["прервать"] = истина;
        вернуть 0;
    }

    если (тип == "ПРОДОЛЖИТЬ") {
        упр["продолжить"] = истина;
        вернуть 0;
    }

    если (тип == "БЛОК") {
        исполнить_блок_функции(узел, среда, рег, упр);
        вернуть 0;
    }

    если (тип == "ЕСЛИ") {
        словарь у;
        у = узел["условие"];
        словарь ув = вычислить_аст(у, среда, рег);
        логическое истина_ли = ложь;
        если (ув["з"] == истина) { истина_ли = истина; }
        если (истина_ли) {
            словарь т;
            т = узел["тело"];
            исполнить_узел(т, среда, рег, упр);
        } иначе {
            словарь блк;
            блк = узел["иначе"];
            если (блк["тип"] != "ПУСТО") {
                исполнить_узел(блк, среда, рег, упр);
            }
        }
        вернуть 0;
    }

    если (тип == "ПОКА") {
        целое макс = 100000;
        пока (истина) {
            словарь у;
            у = узел["условие"];
            словарь ув = вычислить_аст(у, среда, рег);
            логическое истина_ли = ложь;
            если (ув["з"] == истина) { истина_ли = истина; }
            если (истина_ли) {
                словарь т;
                т = узел["тело"];
                исполнить_узел(т, среда, рег, упр);
                если (упр["флаг"] == истина) {
                    прервать;
                }
                если (упр["прервать"] == истина) {
                    упр["прервать"] = ложь;
                    прервать;
                }
                если (упр["продолжить"] == истина) {
                    упр["продолжить"] = ложь;
                }
                макс = макс - 1;
                если (макс == 0) {
                    вывод "ОШИБКА: слишком много итераций";
                    прервать;
                }
            } иначе {
                прервать;
            }
        }
        вернуть 0;
    }

    если (тип == "ВЫЗОВ") {
        вычислить_аст(узел, среда, рег);
        вернуть 0;
    }

    вывод "ОШИБКА исполнителя: неизвестный узел " + тип;
    вернуть 0;
}

// ===== ИСПОЛНЕНИЕ БЛОКА С УЧЁТОМ ПРЕРВАТЬ/ПРОДОЛЖИТЬ/ВЕРНУТЬ =====

функция исполнить_блок_функции(словарь блок, словарь среда, словарь рег, словарь упр) {
    текст тип = блок["тип"];
    если (тип != "БЛОК") {
        исполнить_узел(блок, среда, рег, упр);
        вернуть 0;
    }
    массив опс;
    опс = блок["операторы"];
    целое i = 0;
    пока (i < длина(опс)) {
        словарь о;
        о = опс[i];
        исполнить_узел(о, среда, рег, упр);
        если (упр["флаг"] == истина) {
            прервать;
        }
        если (упр["прервать"] == истина) {
            прервать;
        }
        если (упр["продолжить"] == истина) {
            прервать;
        }
        i = i + 1;
    }
    вернуть 0;
}

// ===== ГЛАВНАЯ ТОЧКА ВХОДА =====

функция исполнить_программу(массив узлы, словарь среда) {
    словарь рег;
    словарь фд;
    словарь гл;
    словарь сох;
    рег["функт"] = фд;
    рег["глубины"] = гл;
    рег["сохранения"] = сох;

    // Регистрация функций
    целое i = 0;
    пока (i < длина(узлы)) {
        словарь уз;
        уз = узлы[i];
        если (уз["тип"] == "ФУНКЦИЯ") {
            текст имя = уз["имя"];
            фд[имя] = уз;
            гл[имя] = знач_число(0);
            массив пр;
            пр = уз["параметры"];
            целое k = 0;
            пока (k < длина(пр)) {
                текст имя_п;
                имя_п = пр[k];
                среда[имя_п] = знач_число(0);
                k = k + 1;
            }
        }
        i = i + 1;
    }

    // Исполнение операторов
    словарь упр;
    упр["флаг"] = ложь;
    упр["значение"] = знач_число(0);
    упр["прервать"] = ложь;
    упр["продолжить"] = ложь;

    i = 0;
    пока (i < длина(узлы)) {
        словарь уз;
        уз = узлы[i];
        если (уз["тип"] != "ФУНКЦИЯ") {
            исполнить_узел(уз, среда, рег, упр);
        }
        i = i + 1;
    }
    вернуть 0;
}

функция главная() {
    текст код_чит = читать_файл("самохостинг/читатель.ямо");
    текст код_сост = читать_файл("самохостинг/составитель.ямо");
    текст код = код_чит + код_сост;
    
    словарь рез;
    разобрать_код(код, рез);
    массив токены = рез["токены"];
    вывод "Всего токенов в конкатенации: " + длина(токены);
    
    целое i = 2970;
    пока (i < 3030) {
        если (i < длина(токены)) {
            словарь т;
            т = токены[i];
            вывод "  [" + i + "] " + т["тип"] + " : " + т["значение"];
        }
        i = i + 1;
    }
}