// Блок: { операторы }
функция парсер_блока(словарь сост) {
    массив операторы = [];

    текст тип = тип_текущего(сост);
    если (тип == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == "{") {
            следующий(сост);
        }
    }

    пока (истина) {
        текст т = тип_текущего(сост);
        если (т == "КОНЕЦ") {
            прервать;
        }
        если (т == "СИМВОЛ") {
            текст з0 = значение_текущего(сост);
            если (з0 == ";") {
                следующий(сост);
                продолжить;
            }
        }
        логическое конец_блока = ложь;
        если (т == "СИМВОЛ") {
            текст зн = значение_текущего(сост);
            если (зн == "}") {
                конец_блока = истина;
            }
        }
        если (конец_блока) {
            следующий(сост);
            прервать;
        }
        словарь оп = парсер_оператора(сост);
        добавить(операторы, оп);
    }

    словарь узел;
    узел["тип"] = "БЛОК";
    узел["операторы"] = операторы;
    вернуть узел;
}

