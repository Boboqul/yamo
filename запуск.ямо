// --- УТИЛИТЫ ДЛЯ РАБОТЫ СО СТРУКТУРАМИ ---
// Поскольку нативный парсер может не поддерживать dict[key] = val,
// используем функции.

// Создать новый пустой словарь
функция новый_словарь() {
    словарь s;
    вернуть s;
}

// Сохранить значение в словарь по ключу
// Возвращает измененный словарь (для цепочки вызовов)
функция сохранить(словарь цель, текст ключ, любой значение) {
    // Здесь должна быть логика мутации словаря. 
    // В идеале C++ движок поддерживает присваивание по ключу внутри функций.
    // Если нет, то эта функция будет падать. Но попробуем стандартное поведение.
    
    // Примечание: Если yamo.exe не позволяет делать цель[ключ] = значение,
    // нам придется эмулировать объекты иначе. 
    // Но обычно интерпретаторы позволяют mutability внутри функций.
    
    // Попробуем прямой доступ, если он разрешен в контексте функции:
    цель[ключ] = значение; 
    вернуть цель;
}

// Создать массив из элементов
функция создать_массив(текст a, текст b) {
    массив m = [];
    добавить(m, a);
    добавить(m, b);
    вернуть m;
}

// --- СИСТЕМА ООП (ГЛОБАЛЬНЫЙ РЕЕСТР + ЛОКАЛЬНЫЕ ОБЪЕКТЫ) ---

// Глобальный реестр классов (будет заполняться при первом использовании)
// В текущей архитектуре C++ глобальные переменные между файлами .ямо 
// могут быть изолированы. Поэтому мы будем хранить реестр внутри специальной 
// структуры, переданной в среду, либо использовать хак с повторным чтением файла.
// Для простоты теста сделаем реестр частью среды выполнения.

// Функция регистрации класса
// имя: строка
// поля: массив строк
// методы: словарь {"имя": "код"}
функция зарегистрировать_класс(словарь среда, текст имя, массив поля, словарь методы) {
    словарь шаблон;
    шаблон["поля"] = поля;
    шаблон["методы"] = методы;
    
    // Сохраняем шаблон в глобальную секцию среды
    // Ключевое слово "__classes__" зарезервируем для реестра
    если (среда["__classes__"] == ложь) {
        среда["__classes__"] = новый_словарь();
    }
    
    словарь реестр = среда["__classes__"];
    реестр[имя] = шаблон;
    
    вернуть истина;
}

// Создание объекта
функция создать_объект(словарь среда, текст имя_класса, массив аргументы) {
    если (среда["__classes__"] == ложь) {
        вывод "ОШИБКА: Нет зарегистрированных классов.";
        вернуть ложь;
    }
    
    словарь реестр = среда["__classes__"];
    если (реестр[имя_класса] == ложь) {
        вывод "ОШИБКА: Класс '" + имя_класса + "' не найден.";
        вернуть ложь;
    }
    
    словарь шаблон = реестр[имя_класса];
    словарь объект;
    
    // Инициализация полей нулями
    массив список_полей = шаблон["поля"];
    целое k = 0;
    пока (k < длина(список_полей)) {
        текст имя_поля = список_полей[k];
        объект[имя_поля] = 0;
        k = k + 1;
    }
    
    // Сохраняем ссылку на класс в объекте
    объект["__class_ref__"] = имя_класса;
    
    // Вызов конструктора
    словарь методы = шаблон["методы"];
    текст ключ_конструктор = "инициализация";
    
    если (методы[ключ_конструктор] != ложь) {
        текст код_конструктора = методы[ключ_конструктор];
        
        // Создаем временную среду для метода, наследующую основную
        словарь среда_метода;
        // Копируем основные данные (упрощенно)
        среда_метода["этот"] = объект;
        
        целое m = 0;
        пока (m < длина(аргументы)) {
            текст имя_переменной_аргумента = "arg_" + m;
            среда_метода[имя_переменной_аргумента] = аргументы[m];
            m = m + 1;
        }
        
        // Парсим и исполняем
        словарь лекс;
        разобрать_код(код_конструктора, лекс);
        массив токены = лекс["токены"];
        
        словарь парс;
        составить(токены, парс);
        массив узлы = парс["узлы"];
        
        исполнить_программу(узлы, среда_метода);
    }
    
    вернуть объект;
}

// Вызов метода
функция вызвать_метод(словарь среда, словарь объект, текст имя_метода, массив аргументы) {
    текст имя_класса = объект["__class_ref__"];
    
    если (среда["__classes__"] == ложь || среда["__classes__"][имя_класса] == ложь) {
        вывод "ОШИБКА: Метаданные класса потеряны.";
        вернуть ложь;
    }
    
    словарь шаблон = среда["__classes__"][имя_класса];
    словарь методы = шаблон["методы"];
    
    если (методы[имя_метода] == ложь) {
        вывод "ОШИБКА: Метод '" + имя_метода + "' не найден.";
        вернуть ложь;
    }
    
    текст код_метода = методы[имя_метода];
    
    словарь среда_метода;
    среда_метода["этот"] = объект;
    
    целое m = 0;
    пока (m < длина(аргументы)) {
        текст имя_переменной_аргумента = "arg_" + m;
        среда_метода[имя_переменной_аргумента] = аргументы[m];
        m = m + 1;
    }
    
    словарь лекс;
    разобрать_код(код_метода, лекс);
    массив токены = лекс["токены"];
    
    словарь парс;
    составить(токены, парс);
    массив узлы = парс["узлы"];
    
    вывод "[ООП] Вызов метода '" + имя_метода + "'...";
    исполнить_программу(узлы, среда_метода);
    
    вернуть истина;
}
