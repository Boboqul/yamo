// читатель.ямо - токенизация исходного кода на ЯМО

функция это_цифра(текст с) {
    если (с >= "0") {
        если (с <= "9") {
            вернуть истина;
        }
    }
    вернуть ложь;
}

функция это_точка(текст с) {
    если (с == ".") {
        вернуть истина;
    }
    вернуть ложь;
}

функция это_латиница(текст с) {
    если (с >= "a") {
        если (с <= "z") {
            вернуть истина;
        }
    }
    если (с >= "A") {
        если (с <= "Z") {
            вернуть истина;
        }
    }
    вернуть ложь;
}

функция это_кириллица(текст с) {
    если (с >= "а") {
        если (с <= "я") {
            вернуть истина;
        }
    }
    если (с == "ё") {
        вернуть истина;
    }
    если (с == "Ё") {
        вернуть истина;
    }
    если (с >= "А") {
        если (с <= "Я") {
            вернуть истина;
        }
    }
    вернуть ложь;
}

функция это_буква(текст с) {
    если (это_кириллица(с)) {
        вернуть истина;
    }
    если (это_латиница(с)) {
        вернуть истина;
    }
    если (с == "_") {
        вернуть истина;
    }
    вернуть ложь;
}

функция это_буква_или_цифра(текст с) {
    если (это_буква(с)) {
        вернуть истина;
    }
    если (это_цифра(с)) {
        вернуть истина;
    }
    вернуть ложь;
}

функция это_кавычка(текст с) {
    текст кав = символ_из_кода(34);
    если (с == кав) {
        вернуть истина;
    }
    вернуть ложь;
}

функция это_пробел(текст с) {
    если (с == " ") {
        вернуть истина;
    }
    если (с == символ_из_кода(10)) {
        вернуть истина;
    }
    если (с == символ_из_кода(9)) {
        вернуть истина;
    }
    вернуть ложь;
}

функция это_перенос(текст с) {
    текст пуст = "";
    если (длина(с) == 0) {
        вернуть ложь;
    }
    если (с == пуст) {
        вернуть ложь;
    }
    логическое рез = ложь;
    если (это_пробел(с)) {
        вернуть ложь;
    }
    логическое буква = это_буква_или_цифра(с);
    если (буква) {
        вернуть ложь;
    }
    вернуть рез;
}

функция проверить_ключ(текст слово) {
    если (слово == "если") { вернуть "КЛЮЧ"; }
    если (слово == "иначе") { вернуть "КЛЮЧ"; }
    если (слово == "пока") { вернуть "КЛЮЧ"; }
    если (слово == "для") { вернуть "КЛЮЧ"; }
    если (слово == "функция") { вернуть "КЛЮЧ"; }
    если (слово == "вернуть") { вернуть "КЛЮЧ"; }
    если (слово == "вывод") { вернуть "КЛЮЧ"; }
    если (слово == "целое") { вернуть "КЛЮЧ"; }
    если (слово == "дробное") { вернуть "КЛЮЧ"; }
    если (слово == "текст") { вернуть "КЛЮЧ"; }
    если (слово == "логическое") { вернуть "КЛЮЧ"; }
    если (слово == "истина") { вернуть "КЛЮЧ"; }
    если (слово == "ложь") { вернуть "КЛЮЧ"; }
    если (слово == "прервать") { вернуть "КЛЮЧ"; }
    если (слово == "продолжить") { вернуть "КЛЮЧ"; }
    если (слово == "массив") { вернуть "КЛЮЧ"; }
    если (слово == "словарь") { вернуть "КЛЮЧ"; }
    если (слово == "класс") { вернуть "КЛЮЧ"; }
    если (слово == "новый") { вернуть "КЛЮЧ"; }
    если (слово == "попробовать") { вернуть "КЛЮЧ"; }
    если (слово == "поймать") { вернуть "КЛЮЧ"; }
    если (слово == "импорт") { вернуть "КЛЮЧ"; }
    если (слово == "выполнить") { вернуть "КЛЮЧ"; }
    вернуть "ИМЯ";
}

функция это_двухсимв_оп(текст с1, текст с2) {
    если (с1 == "=") {
        если (с2 == "=") { вернуть истина; }
    }
    если (с1 == "<") {
        если (с2 == "=") { вернуть истина; }
    }
    если (с1 == ">") {
        если (с2 == "=") { вернуть истина; }
    }
    если (с1 == "&") {
        если (с2 == "&") { вернуть истина; }
    }
    если (с1 == "|") {
        если (с2 == "|") { вернуть истина; }
    }
    если (с1 == "!") {
        если (с2 == "=") { вернуть истина; }
    }
    вернуть ложь;
}

функция разобрать_код(текст код, словарь результат) {
    массив токены = [];
    целое позиция = 0;
    целое длина_кода = длина(код);

    пока (позиция < длина_кода) {
        текст символ = часть(код, позиция, позиция + 1);

        если (это_пробел(символ)) {
            позиция = позиция + 1;
        } иначе {
            если (символ == "/") {
                целое след_поз = позиция + 1;
                если (след_поз < длина_кода) {
                    текст след = часть(код, след_поз, след_поз + 1);
                    если (след == "/") {
                        текст перенос = символ_из_кода(10);
                        пока (позиция < длина_кода) {
                            позиция = позиция + 1;
                            текст с = часть(код, позиция, позиция + 1);
                            если (с == перенос) {
                                позиция = позиция + 1;
                                прервать;
                            }
                        }
                        продолжить;
                    }
                }
            }

            если (это_цифра(символ)) {
                текст число = "";
                пока (позиция < длина_кода) {
                    текст с = часть(код, позиция, позиция + 1);
                    логическое прод = ложь;
                    если (это_цифра(с)) { прод = истина; }
                    если (это_точка(с)) { прод = истина; }
                    если (прод) {
                        число = число + с;
                        позиция = позиция + 1;
                    } иначе {
                        прервать;
                    }
                }
                словарь токен;
                токен["тип"] = "ЧИСЛО";
                токен["значение"] = число;
                добавить(токены, токен);
                продолжить;
            }

            если (это_кавычка(символ)) {
                позиция = позиция + 1;
                текст строка = "";
                пока (позиция < длина_кода) {
                    текст с = часть(код, позиция, позиция + 1);
                    если (это_кавычка(с)) {
                        позиция = позиция + 1;
                        прервать;
                    }
                    строка = строка + с;
                    позиция = позиция + 1;
                }
                словарь токен;
                токен["тип"] = "СТРОКА";
                токен["значение"] = строка;
                добавить(токены, токен);
                продолжить;
            }

            если (это_буква(символ)) {
                текст слово = "";
                пока (позиция < длина_кода) {
                    текст с = часть(код, позиция, позиция + 1);
                    если (это_буква_или_цифра(с)) {
                        слово = слово + с;
                        позиция = позиция + 1;
                    } иначе {
                        прервать;
                    }
                }
                текст тип = проверить_ключ(слово);
                словарь токен;
                токен["тип"] = тип;
                токен["значение"] = слово;
                добавить(токены, токен);
                продолжить;
            }

            целое след_поз = позиция + 1;
            если (след_поз < длина_кода) {
                текст след = часть(код, след_поз, след_поз + 1);
                если (это_двухсимв_оп(символ, след)) {
                    текст оп = символ + след;
                    словарь токен;
                    токен["тип"] = "ОПЕРАТОР";
                    токен["значение"] = оп;
                    добавить(токены, токен);
                    позиция = позиция + 2;
                    продолжить;
                }
            }

            словарь токен;
            токен["тип"] = "СИМВОЛ";
            токен["значение"] = символ;
            добавить(токены, токен);
            позиция = позиция + 1;
        }
    }

    результат["токены"] = токены;
}
// составитель.ямо - парсер токенов в AST
// Состояние парсера хранится в словаре и передаётся через параметры

функция иниц_парсер(массив токены, словарь сост) {
    сост["токены"] = токены;
    сост["поз"] = 0;
}

функция текущий(словарь сост) {
    целое поз = сост["поз"];
    массив токены = сост["токены"];
    если (поз < длина(токены)) {
        словарь т;
        т = токены[поз];
        вернуть т;
    }
    словарь пуст;
    пуст["тип"] = "КОНЕЦ";
    пуст["значение"] = "";
    вернуть пуст;
}

функция следующий(словарь сост) {
    целое поз = сост["поз"];
    сост["поз"] = поз + 1;
}

функция тип_текущего(словарь сост) {
    словарь т = текущий(сост);
    вернуть т["тип"];
}

функция значение_текущего(словарь сост) {
    словарь т = текущий(сост);
    вернуть т["значение"];
}

// Первичные выражения: числа, строки, имена, логические, скобки
функция парсер_первичного(словарь сост) {
    текст тип = тип_текущего(сост);

    если (тип == "ЧИСЛО") {
        словарь узел;
        узел["тип"] = "ЛИТЕРАЛ_ЧИСЛО";
        узел["значение"] = значение_текущего(сост);
        следующий(сост);
        вернуть узел;
    }

    если (тип == "СТРОКА") {
        словарь узел;
        узел["тип"] = "ЛИТЕРАЛ_СТРОКА";
        узел["значение"] = значение_текущего(сост);
        следующий(сост);
        вернуть узел;
    }

    если (тип == "ИМЯ") {
        словарь т2 = токен_смещение(сост, 1);
        логическое вызов = ложь;
        если (т2["тип"] == "СИМВОЛ") {
            текст з2 = т2["значение"];
            если (з2 == "(") {
                вызов = истина;
            }
        }
        если (вызов) {
            текст имяф = значение_текущего(сост);
            следующий(сост);
            следующий(сост);
            массив аргументы = [];
            пока (истина) {
                текст т = тип_текущего(сост);
                если (т == "КОНЕЦ") {
                    прервать;
                }
                логическое конец = ложь;
                если (т == "СИМВОЛ") {
                    текст зн = значение_текущего(сост);
                    если (зн == ")") {
                        конец = истина;
                    }
                }
                если (конец) {
                    следующий(сост);
                    прервать;
                }
                словарь а = парсер_выражения(сост);
                добавить(аргументы, а);
                текст т3 = тип_текущего(сост);
                если (т3 == "СИМВОЛ") {
                    текст зн3 = значение_текущего(сост);
                    если (зн3 == ",") {
                        следующий(сост);
                    }
                }
            }
            словарь узелв;
            узелв["тип"] = "ВЫЗОВ";
            узелв["имя"] = имяф;
            узелв["аргументы"] = аргументы;
            вернуть парсер_индекс_хвост(сост, узелв);
        }
        словарь узел;
        узел["тип"] = "ПЕРЕМЕННАЯ";
        узел["имя"] = значение_текущего(сост);
        следующий(сост);
        вернуть парсер_индекс_хвост(сост, узел);
    }

    если (тип == "КЛЮЧ") {
        текст слово = значение_текущего(сост);
        если (слово == "истина") {
            словарь узел;
            узел["тип"] = "ЛИТЕРАЛ_ЛОГ";
            узел["значение"] = "истина";
            следующий(сост);
            вернуть узел;
        }
        если (слово == "ложь") {
            словарь узел;
            узел["тип"] = "ЛИТЕРАЛ_ЛОГ";
            узел["значение"] = "ложь";
            следующий(сост);
            вернуть узел;
        }
    }

    если (тип == "СИМВОЛ") {
        текст зн0 = значение_текущего(сост);
        если (зн0 == "[") {
            следующий(сост);
            массив элементы = [];
            пока (истина) {
                текст т = тип_текущего(сост);
                если (т == "КОНЕЦ") {
                    прервать;
                }
                логическое конец = ложь;
                если (т == "СИМВОЛ") {
                    текст з = значение_текущего(сост);
                    если (з == "]") {
                        конец = истина;
                    }
                }
                если (конец) {
                    следующий(сост);
                    прервать;
                }
                словарь э = парсер_выражения(сост);
                добавить(элементы, э);
                текст т3 = тип_текущего(сост);
                если (т3 == "СИМВОЛ") {
                    текст з3 = значение_текущего(сост);
                    если (з3 == ",") {
                        следующий(сост);
                    }
                }
            }
            словарь узелм;
            узелм["тип"] = "МАССИВ_ЛИТ";
            узелм["элементы"] = элементы;
            вернуть узелм;
        }
    }
    // Скобки: ( выражение )
    если (тип == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == "(") {
            следующий(сост);
            словарь внутр = парсер_выражения(сост);
            текст тип2 = тип_текущего(сост);
            если (тип2 == "СИМВОЛ") {
                текст зн2 = значение_текущего(сост);
                если (зн2 == ")") {
                    следующий(сост);
                }
            }
            вернуть внутр;
        }
    }

    словарь узел;
    узел["тип"] = "ОШИБКА";
    узел["сообщение"] = "Неожиданный токен: " + тип;
    вернуть узел;
}

// Умножение и деление (высокий приоритет)
функция парсер_умножения(словарь сост) {
    словарь левый = парсер_первичного(сост);

    пока (тип_текущего(сост) == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        логическое умн = ложь;
        логическое дел = ложь;
        если (зн == "*") { умн = истина; }
        если (зн == "/") { дел = истина; }
        если (умн) {
            следующий(сост);
            словарь правый = парсер_первичного(сост);
            словарь узел;
            узел["тип"] = "БИНАРНАЯ";
            узел["оп"] = "*";
            узел["левый"] = левый;
            узел["правый"] = правый;
            левый = узел;
        } иначе {
            если (дел) {
                следующий(сост);
                словарь правый = парсер_первичного(сост);
                словарь узел;
                узел["тип"] = "БИНАРНАЯ";
                узел["оп"] = "/";
                узел["левый"] = левый;
                узел["правый"] = правый;
                левый = узел;
            } иначе {
                прервать;
            }
        }
    }

    вернуть левый;
}

// Сложение и вычитание (низкий приоритет)
функция парсер_сложения(словарь сост) {
    словарь левый = парсер_умножения(сост);

    пока (тип_текущего(сост) == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        логическое плюс = ложь;
        логическое минус = ложь;
        если (зн == "+") { плюс = истина; }
        если (зн == "-") { минус = истина; }
        если (плюс) {
            следующий(сост);
            словарь правый = парсер_умножения(сост);
            словарь узел;
            узел["тип"] = "БИНАРНАЯ";
            узел["оп"] = "+";
            узел["левый"] = левый;
            узел["правый"] = правый;
            левый = узел;
        } иначе {
            если (минус) {
                следующий(сост);
                словарь правый = парсер_умножения(сост);
                словарь узел;
                узел["тип"] = "БИНАРНАЯ";
                узел["оп"] = "-";
                узел["левый"] = левый;
                узел["правый"] = правый;
                левый = узел;
            } иначе {
                прервать;
            }
        }
    }

    вернуть левый;
}

// Сравнение: ==, !=, <, >, <=, >=
функция парсер_сравнения(словарь сост) {
    словарь левый = парсер_сложения(сост);

    пока (истина) {
        текст тип = тип_текущего(сост);
        логическое есть_оп = ложь;
        текст оп = "";
        если (тип == "ОПЕРАТОР") {
            оп = значение_текущего(сост);
            есть_оп = истина;
        }
        если (тип == "СИМВОЛ") {
            текст зн = значение_текущего(сост);
            если (зн == "<") { оп = "<"; есть_оп = истина; }
            если (зн == ">") { оп = ">"; есть_оп = истина; }
        }
        если (есть_оп) {
            следующий(сост);
            словарь правый = парсер_сложения(сост);
            словарь узел;
            узел["тип"] = "БИНАРНАЯ";
            узел["оп"] = оп;
            узел["левый"] = левый;
            узел["правый"] = правый;
            левый = узел;
        } иначе {
            прервать;
        }
    }

    вернуть левый;
}

// Полное выражение
функция парсер_выражения(словарь сост) {
    вернуть парсер_сравнения(сост);
}

// Присваивание: имя = выражение
функция парсер_присваивания(словарь сост) {
    словарь имя_узел = парсер_выражения(сост);

    текст тип = тип_текущего(сост);
    если (тип == "СИМВОЛ") {
        текст зн = значение_текущего(сост);
        если (зн == "=") {
            следующий(сост);
            словарь знач = парсер_выражения(сост);
            словарь узел;
            узел["тип"] = "ПРИСВАИВАНИЕ";
            узел["цель"] = имя_узел;
            узел["значение"] = знач;
            вернуть узел;
        }
    }

    вернуть имя_узел;
}

// Точка входа: разбирает программу из токенов
функция составить(массив токены, словарь результат) {
    целое прогресс = 0;
    текст отл = "отл_парс";
    словарь отладка;
    отладка["всего"] = длина(токены);
    отладка["текущий"] = 0;
    результат[отл] = отладка;
    словарь сост;
    иниц_парсер(токены, сост);
    массив узлы = [];

    целое счётчик = 0;
    целое след_печать = 100;
    пока (тип_текущего(сост) != "КОНЕЦ") {
        целое поз_до = сост["поз"];
        словарь узел = парсер_оператора(сост);
        добавить(узлы, узел);
        счётчик = счётчик + 1;
        если (счётчик >= след_печать) {
            вывод "ПРОГРЕСС: " + счётчик + " узлов, поз=" + сост["поз"];
            след_печать = след_печать + 100;
        }
        если (сост["поз"] == поз_до) {
            следующий(сост);
        }
    }

    результат["узлы"] = узлы;
}

// Токен со смещением (заглядывание вперёд)
