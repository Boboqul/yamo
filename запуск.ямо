// Функция: функция имя(параметры) { тело }
функция парсер_индекс_хвост(словарь сост, словарь база) {
    пока (истина) {
        текст тт = тип_текущего(сост);
        логическое есть = ложь;
        если (тт == "СИМВОЛ") {
            текст зз = значение_текущего(сост);
            если (зз == "[") {
                есть = истина;
            }
        }
        если (есть) {
            следующий(сост);
            словарь ид = парсер_выражения(сост);
            текст т2 = тип_текущего(сост);
            если (т2 == "СИМВОЛ") {
                текст з2 = значение_текущего(сост);
                если (з2 == "]") {
                    следующий(сост);
                }
            }
            словарь ин;
            ин["тип"] = "ИНДЕКС";
            ин["база"] = база;
            ин["индекс"] = ид;
            база = ин;
        } иначе {
            прервать;
        }
    }
    вернуть база;
}
функция парсер_функции(словарь сост) {
    следующий(сост);
    текст имя = значение_текущего(сост);
    следующий(сост);

    массив параметры = [];
    текст т0 = тип_текущего(сост);
    если (т0 == "СИМВОЛ") {
        текст з0 = значение_текущего(сост);
        если (з0 == "(") {
            следующий(сост);
        }
    }

    пока (истина) {
        текст т = тип_текущего(сост);
        если (т == "КОНЕЦ") {
            прервать;
        }
        логическое конец = ложь;
        если (т == "СИМВОЛ") {
