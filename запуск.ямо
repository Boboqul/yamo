// Диспетчер операторов
функция парсер_оператора(словарь сост) {
    текст тип = тип_текущего(сост);

    если (тип == "КЛЮЧ") {
        текст слово = значение_текущего(сост);
        если (слово == "если") {
            вернуть парсер_если(сост);
        }
        если (слово == "функция") {
            вернуть парсер_функции(сост);
        }
        если (слово == "вернуть") {
            вернуть парсер_вернуть(сост);
        }
        если (слово == "прервать") {
            следующий(сост);
            текст тп = тип_текущего(сост);
            если (тп == "СИМВОЛ") {
                текст зп = значение_текущего(сост);
                если (зп == ";") {
                    следующий(сост);
                }
            }
            словарь узелп;
            узелп["тип"] = "ПРЕРВАТЬ";
            вернуть узелп;
        }
        если (слово == "продолжить") {
            следующий(сост);
            текст тп = тип_текущего(сост);
            если (тп == "СИМВОЛ") {
                текст зп = значение_текущего(сост);
                если (зп == ";") {
                    следующий(сост);
                }
            }
            словарь узелп;
            узелп["тип"] = "ПРОДОЛЖИТЬ";
            вернуть узелп;
        }
        если (слово == "словарь") {
            вернуть парсер_объявления(сост, "словарь");
        }
        если (слово == "массив") {
            вернуть парсер_объявления(сост, "массив");
        }
        если (слово == "пока") {
            вернуть парсер_пока(сост);
        }
        если (слово == "вывод") {
            вернуть парсер_вывод(сост);
        }
        если (слово == "целое") {
            вернуть парсер_объявления(сост, "целое");
        }
        если (слово == "дробное") {
            вернуть парсер_объявления(сост, "дробное");
        }
        если (слово == "текст") {
            вернуть парсер_объявления(сост, "текст");
        }
        если (слово == "логическое") {
            вернуть парсер_объявления(сост, "логическое");
        }
    }

    словарь узел = парсер_присваивания(сост);

    текст тип2 = тип_текущего(сост);
    если (тип2 == "СИМВОЛ") {
        текст зн2 = значение_текущего(сост);
        если (зн2 == ";") {
            следующий(сост);
        }
    }

    вернуть узел;
}

// Печать блоков и операторов// Печать AST для отладки
функция печать_узла(словарь узел, целое глубина) {
    текст отступ = "";
    целое i = 0;
    пока (i < глубина) {
        отступ = отступ + "  ";
        i = i + 1;
    }

    текст тип = узел["тип"];

    если (тип == "ЛИТЕРАЛ_ЧИСЛО") {
        вывод отступ + "ЧИСЛО: " + узел["значение"];
    }
    если (тип == "ЛИТЕРАЛ_СТРОКА") {
        вывод отступ + "СТРОКА: " + узел["значение"];
    }
    если (тип == "ЛИТЕРАЛ_ЛОГ") {
        вывод отступ + "ЛОГ: " + узел["значение"];
    }
    если (тип == "ПЕРЕМЕННАЯ") {
        вывод отступ + "ПЕРЕМЕННАЯ: " + узел["имя"];
    }
    если (тип == "БИНАРНАЯ") {
        вывод отступ + "БИНАРНАЯ [" + узел["оп"] + "]";
        словарь л;
        л = узел["левый"];
        печать_узла(л, глубина + 1);
        словарь п;
        п = узел["правый"];
        печать_узла(п, глубина + 1);
    }
    если (тип == "ПРИСВАИВАНИЕ") {
        вывод отступ + "ПРИСВАИВАНИЕ";
        словарь ц;
        ц = узел["цель"];
        печать_узла(ц, глубина + 1);
        словарь з;
        з = узел["значение"];
        печать_узла(з, глубина + 1);
    }
    если (тип == "ОШИБКА") {
        вывод отступ + "ОШИБКА: " + узел["сообщение"];
    }
    если (тип == "ФУНКЦИЯ") {
        вывод отступ + "ФУНКЦИЯ: " + узел["имя"];
        массив пр;
        пр = узел["параметры"];
        вывод отступ + "  параметры: " + длина(пр);
        словарь т;
        т = узел["тело"];
        печать_узла(т, глубина + 1);
    }
    если (тип == "ВЫЗОВ") {
        вывод отступ + "ВЫЗОВ: " + узел["имя"];
        массив ар;
        ар = узел["аргументы"];
        целое j = 0;
        пока (j < длина(ар)) {
            словарь а;
            а = ар[j];
            печать_узла(а, глубина + 1);
            j = j + 1;
        }
    }
    если (тип == "ВЕРНУТЬ") {
        вывод отступ + "ВЕРНУТЬ:";
        словарь з;
        з = узел["значение"];
        печать_узла(з, глубина + 1);
    }
    если (тип == "БЛОК") {
        вывод отступ + "БЛОК:";
        массив опс;
        опс = узел["операторы"];
        целое j = 0;
        пока (j < длина(опс)) {
            словарь о;
            о = опс[j];
            печать_узла(о, глубина + 1);
            j = j + 1;
        }
    }
    если (тип == "ЕСЛИ") {
        вывод отступ + "ЕСЛИ:";
        вывод отступ + "  условие:";
        словарь у;
        у = узел["условие"];
        печать_узла(у, глубина + 2);
        вывод отступ + "  тело:";
        словарь т;
        т = узел["тело"];
        печать_узла(т, глубина + 2);
        словарь блк;
        блк = узел["иначе"];
        если (блк["тип"] != "ПУСТО") {
            вывод отступ + "  иначе:";
            печать_узла(блк, глубина + 2);
        }
    }
    если (тип == "ПОКА") {
        вывод отступ + "ПОКА:";
        вывод отступ + "  условие:";
        словарь у;
        у = узел["условие"];
        печать_узла(у, глубина + 2);
        вывод отступ + "  тело:";
        словарь т;
        т = узел["тело"];
        печать_узла(т, глубина + 2);
    }
    если (тип == "ВЫВОД") {
        вывод отступ + "ВЫВОД:";
        словарь з;
        з = узел["значение"];
        печать_узла(з, глубина + 1);
    }
    если (тип == "ОБЪЯВЛЕНИЕ") {
        вывод отступ + "ОБЪЯВЛЕНИЕ " + узел["тип_перем"] + " " + узел["имя"];
        словарь з;
        з = узел["значение"];
        если (з["тип"] != "ПУСТО") {
            печать_узла(з, глубина + 1);
        }
    }
}

функция печать_ast(массив узлы) {
    целое i = 0;
    пока (i < длина(узлы)) {
        словарь узел;
        узел = узлы[i];
        вывод "--- узел " + (i + 1) + " ---";
        печать_узла(узел, 0);
        i = i + 1;
    }
}
// исполни.ямо — Мета-интерпретатор ЯМО (Безопасная версия для совместимости)

функция исполнить_программу(массив узлы, словарь среда) {
    целое i = 0;
    пока (i < длина(узлы)) {
        словарь узел = узлы[i];
        текст тип = узел["тип"];
        
        // --- ОБРАБОТКА КЛАССА ---
        если (тип == "КЛАСС") {
            текст имя_класса = узел["имя"];
            массив поля = узел["поля"];      
            массив методы = узел["методы"];  
            
            словарь шаблон_класса;
            шаблон_класса["поля"] = поля;
            
            словарь таблица_методов;
            целое j = 0;
            пока (j < длина(методы)) {
                словарь метод = методы[j];
                текст имя_метода = метод["имя"];
                таблица_методов[имя_метода] = метод;
                j = j + 1;
            }
            шаблон_класса["методы"] = таблица_методов;
            
            среда[имя_класса] = шаблон_класса;
            вывод "[DEBUG] Зарегистрирован класс: " + имя_класса;
        }
        
        // --- ОБРАБОТКА СОЗДАНИЯ ОБЪЕКТА ---
        иначе_если (тип == "СОЗДАНИЕ_ОБЪЕКТА") {
            текст имя_класса = узел["класс"];
            массив аргументы = узел["аргументы"];
            
            если (среда[имя_класса] == ложь) {
                вывод "ОШИБКА: Класс '" + имя_класса + "' не найден.";
                вернуть;
            }
            
            словарь шаблон = среда[имя_класса];
            словарь объект;
            
            // Инициализация полей
            массив список_полей = шаблон["поля"];
            целое k = 0;
            пока (k < длина(список_полей)) {
                словарь поле = список_полей[k];
                текст имя_поля = поле["имя"];
                объект[имя_поля] = 0; 
                k = k + 1;
            }
            
            // Вызов конструктора
            словарь методы = шаблон["методы"];
            текст ключ_конструктор = "инициализация";
            
            если (методы[ключ_конструктор] != ложь) {
                словарь метод_конструктор = методы[ключ_конструктор];
                
                словарь среда_метода;
                среда_метода["этот"] = объект;
                
                целое m = 0;
                пока (m < длина(аргументы)) {
                    текст имя_переменной_аргумента = "arg_" + m;
                    среда_метода[имя_переменной_аргумента] = аргументы[m];
                    m = m + 1;
                }
                
                массив тело_кода = метод_конструктор["тело"];
                исполнить_блок_кода(тело_кода, среда_метода);
            }
            
            текст имя_переменной = узел["переменная"];
            если (имя_переменной != "") {
                среда[имя_переменной] = объект;
            }
        }
        
        // --- ОБРАБОТКА ВЫЗОВА МЕТОДА ---
        иначе_если (тип == "ВЫЗОВ_МЕТОДА") {
            текст имя_объекта = узел["объект"];
            текст имя_метода = узел["метод"];
            
            если (среда[имя_объекта] == ложь) {
                вывод "ОШИБКА: Объект '" + имя_объекта + "' не найден.";
                вернуть;
            }
            
            вывод "[DEBUG] Попытка вызвать метод '" + имя_метода + "' у объекта '" + имя_объекта + "'.";
        }
        
        // --- СТАНДАРТНЫЕ ОПЕРАЦИИ ---
        иначе_если (тип == "ФУНКЦИЯ") {
            текст имя_фун = узел["имя"];
            среда[имя_фун] = узел;
        }
        иначе_если (тип == "ВЫВОД") {
            вывод узел["значение"];
        }
        иначе_если (тип == "ПРИСВАИВАНИЕ") {
            среда[узел["переменная"]] = узел["значение"];
        }
        иначе_если (тип == "ВЫЗОВ_ФУНКЦИИ") {
            текст имя_фун = узел["имя"];
            если (среда[имя_фун] != ложь) {
                 // БЕЗОПАСНЫЙ ДОСТУП К АРГУМЕНТАМ ЧЕРЕЗ ПРОМЕЖУТОЧНУЮ ПЕРЕМЕННУЮ
                массив список_арг = узел["аргументы"];
                
                если (имя_фун == "фибо") {
                     // Берем первый аргумент безопасно
                    если (длина(список_арг) > 0) {
                        целое n = список_арг[0];
                        целое результат = вычислить_фибо(n);
                        
                         // Сохраняем результат, если есть переменная назначения
                        текст имя_рез = узел["переменная"];
                        если (имя_рез != "") {
                            среда[имя_рез] = результат;
                        }
                    }
                } иначе {
                    вывод "[WARN] Функция '" + имя_фун + "' не реализована.";
                }
            }
        }
        
        i = i + 1;
    }
}

