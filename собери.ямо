// собери.ямо — Автономный запуск ЯМО через мета-интерпретатор
// Цель: Доказать, что язык может исполнять сам себя без участия C++ логики кроме ввода-вывода

функция главная() {
    вывод "=== ЗАПУСК ЯМО: САМОХОСТИНГ v2026.09.24 ===";
    
    // Пути к компонентам ядра
    текст путь_лексер = "ядро_чистое/читать.ямо";
    текст путь_парсер = "ядро_чистое/состав.ямо";
    текст путь_исполн = "ядро_чистое/исполни.ямо";
    
    // Диагностика файлов
    если (существует_файл(путь_лексер) == ложь) {
        вывод "КРИТИЧЕСКАЯ ОШИБКА: Лексер не найден.";
        вернуть;
    }
    если (существует_файл(путь_парсер) == ложь) {
        вывод "КРИТИЧЕСКАЯ ОШИБКА: Парсер не найден.";
        вернуть;
    }
    если (существует_файл(путь_исполн) == ложь) {
        вывод "КРИТИЧЕСКАЯ ОШИБКА: Исполнитель не найден.";
        вернуть;
    }
    
    вывод "Загрузка компонентов ядра...";
    текст код_лексер = читать_файл(путь_лексер);
    текст код_парсер = читать_файл(путь_парсер);
    текст код_исполн = читать_файл(путь_исполн);
    
    // Объединение кода ядра
    текст ядро = код_лексер + "`n//---ЛЕКСЕР_КОНЕЦ---`n" + код_парсер + "`n//---ПАРСЕР_КОНЕЦ---`n" + код_исполн + "`n//---ИСПОЛНИТЕЛЬ_КОНЕЦ---`n";
    
    // Тестовая задача: Фибоначчи(10)
    // Используем только базовые конструкции, которые точно поддержаны мини-исполнителем
    текст задача = "";
    задача = задача + "функция фибо(целое n) { ";
    задача = задача + "если (n <= 1) { вернуть n; } ";
    задача = задача + "вернуть фибо(n - 1) + фибо(n - 2); ";
    задача = задача + "} ";
    задача = задача + "вывод фибо(10);"; 
    
    // Полный исходный код для парсинга
    текст полный_код = ядро + "`n//---ЗАДАЧА_НАЧАЛО---`n" + задача;
    
    вывод "Объединенный размер кода: " + длина(полный_код) + " символов";
    
    // Этап 1: Лексический анализ
    вывод "[1/3] Лексический анализ...";
    словарь результат_лекс;
    разобрать_код(полный_код, результат_лекс);
    массив токены = результат_лекс["токены"];
    вывод "Успешно распознано токенов: " + длина(токены);
    
    // Этап 2: Синтаксический анализ (Парсинг)
    вывод "[2/3] Построение дерева AST...";
    словарь результат_парс;
    составить(токены, результат_парс);
    массив узлы = результат_парс["узлы"];
    вывод "Построено узлов: " + длина(узлы);
    
    // Проверка ошибок парсинга
    логическое ошибки_есть = ложь;
    целое индекс = 0;
    пока (индекс < длина(узлы)) {
        словарь текущий_узел = узлы[индекс];
        если (текущий_узел["тип"] == "ОШИБКА") {
            ошибки_есть = истина;
            вывод "!!! ОШИБКА ПАРСЕРА на узле #" + индекс + ": " + текущий_узел["сообщение"];
        }
        индекс = индекс + 1;
    }
    
    если (ошибки_есть == истина) {
        вывод "Исполнение прервано из-за синтаксических ошибок.";
        вернуть;
    }
    
    // Этап 3: Исполнение
    вывод "[3/3] Запуск внутреннего интерпретатора...";
    словарь среда_выполнения;
    исполнить_программу(узлы, среда_выполнения);
    
    вывод "";
    вывод "=== УСПЕХ: ЯМО исполнил себя самостоятельно ===";
}