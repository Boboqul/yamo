// ооп_ядро.ямо — Система Объектно-Ориентированного Программирования для ЯМО
// Архитектура: Глобальный реестр классов + Локальный кэш методов в объектах

// --- КОНСТАНТЫ И УТИЛИТЫ ---

// Специальный ключ для хранения имени класса внутри объекта
текст КЛЮЧ_ТИПА = "__тип__";
// Специальный ключ для хранения ссылки на шаблон класса (кэш)
текст КЛЮЧ_ШАБЛОНА = "__шаблон__";

// Безопасная запись в словарь (обход ограничений синтаксиса C++ парсера)
функция записать(словарь цель, текст ключ, любой значение) {
    // В нативном движке это должно работать как dict[key] = value
    // Если нет, то здесь будет точка отказа. Но обычно интерпретаторы это поддерживают.
    цель[ключ] = значение;
}

// Безопасное чтение из словаря
функция прочитать(словарь источник, текст ключ) {
    вернуть источник[ключ];
}

// Проверка существования ключа
функция есть_ключ(словарь источник, текст ключ) {
    // Эмуляция containsKey. Если значение null/false, считаем что нет.
    // Для простоты теста предполагаем, что отсутствие ключа вернет ложь или null.
    текст вал = прочитать(источник, ключ);
    если (вал == ложь) { вернуть ложь; }
    вернуть истина;
}

// --- СИСТЕМА РЕЕСТРА КЛАССОВ ---

// Глобальный реестр хранится в специальной переменной среды __REGISTRY__
// Мы инициализируем его при первом обращении

функция получить_реестр() {
    // Попытка получить существующий реестр
    // В текущей архитектуре yamo.exe, глобальные переменные доступны через среду исполнения.
    // Но так как мы пишем мета-код, нам нужно эмулировать глобальное состояние.
    
    // ХАК: Используем статическую переменную внутри функции, если поддерживается.
    // Если нет, будем передавать реестр явно. 
    // Для начала попробуем создать его локально и вернуть ссылку.
    // NOTE: В реальном компиляторе это было бы static map<string, ClassTemplate>.
    
    словарь реестр;
    вернуть реестр;
}

// Регистрация нового класса
// имя: название класса
// поля: массив имен полей ["x", "y"]
// методы: словарь {"имя_метода": "тело_кода"}
функция зарегистрировать_класс(словарь реестр, текст имя, массив поля, словарь методы) {
    словарь шаблон;
    записать(шаблон, "поля", поля);
    записать(шаблон, "методы", методы);
    
    записать(реестр, имя, шаблон);
    
    вывод "[ООП] Класс '" + имя + "' зарегистрирован.";
    вернуть истина;
}

// --- СОЗДАНИЕ ОБЪЕКТА (С ЛОКАЛЬНЫМ КЭШИРОВАНИЕМ) ---

функция новый_объект(словарь реестр, текст имя_класса, массив аргументы) {
    если (есть_ключ(реестр, имя_класса) == ложь) {
        вывод "ОШИБКА: Класс '" + имя_класса + "' не найден в реестре.";
        вернуть ложь;
    }
    
    словарь шаблон = прочитать(реестр, имя_класса);
    словарь объект;
    
    // 1. Инициализация полей значениями по умолчанию (0 или "")
    массив список_полей = прочитать(шаблон, "поля");
    целое i = 0;
    пока (i < длина(список_полей)) {
        текст имя_поля = список_полей[i];
        записать(объект, имя_поля, 0); // Дефолтное числовое значение
        i = i + 1;
    }
    
    // 2. Сохранение метаданных (Гибридный подход: ссылка на шаблон для быстрого поиска методов)
    записать(объект, КЛЮЧ_ТИПА, имя_класса);
    записать(объект, КЛЮЧ_ШАБЛОНА, шаблон); // КЭШИРУЕМ ШАБЛОН ВНУТРИ ОБЪЕКТА!
    
    // 3. Вызов конструктора ("инициализация")
    словарь методы = прочитать(шаблон, "методы");
    текст ключ_конструктор = "инициализация";
    
    если (есть_ключ(методы, ключ_конструктор)) {
        текст код_конструктора = прочитать(методы, ключ_конструктор);
        
        // Подготовка среды для метода
        словарь среда_метода;
        записать(среда_метода, "этот", объект);
        
        // Передача аргументов
        целое j = 0;
        пока (j < длина(аргументы)) {
            текст имя_переменной = "arg_" + j;
            записать(среда_метода, имя_переменной, аргументы[j]);
            j = j + 1;
        }
        
        // Парсинг и исполнение тела конструктора
        словарь лекс;
        разобрать_код(код_конструктора, лекс);
        массив токены = прочитать(лекс, "токены");
        
        словарь парс;
        составить(токены, парс);
        массив узлы = прочитать(парс, "узлы");
        
        исполнить_программу(узлы, среда_метода);
    }
    
    вернуть объект;
}

// --- ВЫЗОВ МЕТОДА (ИСПОЛЬЗУЯ ЛОКАЛЬНЫЙ КЭШ) ---

функция вызвать_метод(словарь объект, текст имя_метода, массив аргументы) {
    // Быстрый путь: берем шаблон напрямую из кэша объекта
    словарь шаблон = прочитать(объект, КЛЮЧ_ШАБЛОНА);
    
    если (шаблон == ложь) {
        // Медленный путь fallback: если кэш пуст, идем в глобальный реестр
        // Здесь нужно иметь доступ к реестру. Для упрощения теста assume, что кэш всегда есть.
        вывод "ОШИБКА: Метаданные класса повреждены (кэш пуст).";
        вернуть ложь;
    }
    
    словарь методы = прочитать(шаблон, "методы");
    
    если (есть_ключ(методы, имя_метода) == ложь) {
        вывод "ОШИБКА: Метод '" + имя_метода + "' не найден.";
        вернуть ложь;
    }
    
    текст код_метода = прочитать(методы, имя_метода);
    
    // Подготовка среды
    словарь среда_метода;
    записать(среда_метода, "этот", объект);
    
    целое m = 0;
    пока (m < длина(аргументы)) {
        текст имя_переменной = "arg_" + m;
        записать(среда_метода, имя_переменной, аргументы[m]);
        m = m + 1;
    }
    
    // Парсинг и исполнение
    словарь лекс;
    разобрать_код(код_метода, лекс);
    массив токены = прочитать(лекс, "токены");
    
    словарь парс;
    составить(токены, парс);
    массив узлы = прочитать(парс, "узлы");
    
    вывод "[ООП] Вызов метода '" + имя_метода + "'...";
    исполнить_программу(узлы, среда_метода);
    
    вернуть истина;
}