// основной.ямо — Главный исполнитель языка ЯМО v2026.09.24

функция главная() {
    вывод "==========================================";
    вывод "   ЯМО v2026.09.24 | Самохостинг Активен";
    вывод "==========================================";
    
    массив аргументы = получить_аргументы();
    
    если (длина(аргументы) < 2) {
        вывод "❌ Ошибка: Не указан файл программы.";
        вернуть;
    }
    
    текст путь_файла = аргументы[1];
    
    // 1. Чтение
    вывод "[1/3] Чтение: " + путь_файла;
    текст код = читать_файл(путь_файла);
    если (код == "") {
        вывод "❌ Файл пуст или не найден.";
        вернуть;
    }
    
    // 2. Лексика
    вывод "[2/3] Лексика...";
    массив токены = нативный_лексер(код);
    если (токены == []) {
        вывод "❌ Ошибка лексера.";
        вернуть;
    }
    
    // 3. Парсинг (Результат сохраняется внутри C++ автоматически)
    вывод "[3/3] Парсинг...";
    текст статус_парса = нативный_парсер(токены);
    если (статус_парса != "OK") {
        вывод "❌ Ошибка парсера.";
        вернуть;
    }
    
    // 4. Исполнение (C++ берет AST из своей памяти)
    вывод "--- ЗАПУСК ---";
    целое код_выхода = нативный_интерпретатор([]); // Аргументы не нужны, берем глобалку
    
    вывод "--- КОНЕЦ ---";
    если (код_выхода == 0) {
        вывод "✅ Успешно завершено.";
    } иначе {
        вывод "⚠️ Ошибка выполнения.";
    }
}

главная();