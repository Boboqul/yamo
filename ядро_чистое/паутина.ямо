// паутина.ямо — Модуль веб-сервера для языка ЯМО
// Версия: 2026.10.05 Alpha

класс Запрос {
    текст метод;      // GET, POST
    текст путь;       // /index.html
    словарь заголовки;
    текст тело;
}

класс Ответ {
    целое статус = 200;
    словарь заголовки;
    текст тело;
}

// Внутренний реестр маршрутов
словарь маршруты; // Ключ: путь ("/"), Значение: имя функции ("главная")

функция зарегистрировать(текст путь, текст имя_функции) {
    маршруты[путь] = имя_функции;
    вывод "[Паутина] Маршрут '" + путь + "' -> '" + имя_функции + "'";
}

// Парсер HTTP-запроса (упрощенный)
функция разобрать_запрос(текст сырые_данные) {
    Запрос req = новый Запрос();
    
    массив линии = разделить(сырые_данные, "\r\n");
    если (длина(линии) == 0) вернуть req;
    
    // Первая строка: METHOD PATH VERSION
    массив части = разделить(линии[0], " ");
    если (длина(части) >= 2) {
        req.метод = части[0];
        req.путь = части[1];
    } иначе {
        req.метод = "GET";
        req.путь = "/";
    }
    
    // Заголовки (вторые строки до пустой)
    целое i = 1;
    пока (i < длина(линии) && линии[i] != "") {
        массив kv = разделить(линии[i], ": ");
        если (длина(kv) == 2) {
            req.заголовки[kv[0]] = kv[1];
        }
        i = i + 1;
    }
    
    // Тело запроса (остальное после пустой строки)
    текст body_text = "";
    для (целое j = i + 1; j < длина(линии); j = j + 1) {
        body_text = body_text + линии[j] + "\r\n";
    }
    req.тело = body_text;
    
    вернуть req;
}

// Генератор HTTP-ответа
функция собрать_ответ(Ответ resp) {
    текст http_line = "HTTP/1.1 " + в_текст(resp.статус) + " OK\r\n";
    
    // Content-Type по умолчанию
    если (resp.заголовки["Content-Type"] == null) {
        resp.заголовки["Content-Type"] = "text/html; charset=utf-8";
    }
    
    // Content-Length обязателен
    resp.заголовки["Content-Length"] = в_текст(длина(resp.тело));
    
    текст headers_text = "";
    массив keys = ключи(resp.заголовки);
    для (целое i = 0; i < длина(keys); i = i + 1) {
        текст key = keys[i];
        headers_text = headers_text + key + ": " + resp.заголовки[key] + "\r\n";
    }
    
    вернуть http_line + headers_text + "\r\n" + resp.тело;
}

// Главный цикл сервера
функция слушать(целое порт) {
    вывод "🌐 Паутина запускается на порту " + порт;
    
    целое мастер = сеть_открыть(порт);
    
    пока (истина) {
        вывод "... ожидание гостей...";
        целое клиент = сеть_принять(мастер);
        
        // Читаем запрос
        текст сырые_данные = сеть_прочитать(клиент, 4096);
        
        если (сырые_данные != "") {
            Запрос req = разобрать_запрос(сырые_данные);
            
            // Ищем обработчик
            текст handler_name = маршруты[req.путь];
            
            Ответ resp = новый Ответ();
            
            если (handler_name != null) {
                // Вызываем функцию динамически
                // Здесь требуется поддержка execute_function_by_name в интерпретаторе
                // Для MVP предположим, что функция возвращает текст HTML
                resp.тело = выполнить(handler_name + "(req)"); 
            } иначе {
                resp.статус = 404;
                resp.тело = "<h1>404 Not Found</h1><p>Маршрут '" + req.путь + "' не существует.</p>";
            }
            
            // Отправляем ответ
            текст full_response = собрать_ответ(resp);
            сеть_написать(клиент, full_response);
        }
        
        сеть_закрыть(клиент);
    }
}