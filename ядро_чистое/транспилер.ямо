// транспилер.ямо — Генератор кода на C++ из AST ЯМО
// Все идентификаторы и логика на русском языке.

класс Транспилер {
    текст путь_выхода; // Куда сохранять .cpp файл
    
    функция инициализация(текст путь) {
        этот.путь_выхода = путь;
    }
    
    // Главная точка входа: принимает корень дерева AST и возвращает строку C++ кода
    функция создать_код(массив узлы_ast) {
        текст код_cpp = "";
        
        // 1. Заголовочные файлы (Standard Library)
        код_cpp = код_cpp + "#include <iostream>\n";
        код_cpp = код_cpp + "#include <string>\n";
        код_cpp = код_cpp + "#include <vector>\n";
        код_cpp = код_cpp + "#include <map>\n";
        код_cpp = код_cpp + "#include <cmath>\n";
        код_cpp = код_cpp + "\n";
        
        // 2. Алиасы типов ЯМО -> Типы C++
        // Чтобы в сгенерированном коде было удобно читать
        код_cpp = код_cpp + "using Текст = std::string;\n";
        код_cpp = код_cpp + "using Целое = long long;\n";
        код_cpp = код_cpp + "using Дробное = double;\n";
        код_cpp = код_cpp + "using Логическое = bool;\n";
        код_cpp = код_cpp + "\n";
        
        // 3. Рекурсивная обходка всех узлов верхнего уровня
        целое i = 0;
        пока (i < длина(узлы_ast)) {
            код_cpp = код_cpp + этот.преобразовать_узел(узлы_ast[i]);
            i = i + 1;
        }
        
        вернуть код_cpp;
    }
    
    // Диспетчер: определяет тип узла и вызывает соответствующий генератор
    функция преобразовать_узел(словарь узел) {
        текст тип = узел["тип"];
        
        если (тип == "ОбъявлениеКласса") {
            вернуть этот.сгенерировать_класс(узел);
        } иначе_если (тип == "ОбъявлениеФункции") {
            вернуть этот.сгенерировать_функцию(узел);
        } иначе_если (тип == "ОбъявлениеПеременной") {
            вернуть этот.сгенерировать_переменную(узел);
        } иначе_если (тип == "ОператорВывод") {
            вернуть этот.сгенерировать_вывод(узел);
        } иначе_если (тип == "ОператорВозврат") {
            вернуть этот.сгенерировать_возврат(узел);
        } иначе {
            // Для неизвестных узлов добавляем комментарий, чтобы компилятор C++ не упал
            вернуть "// Неизвестный узел типа: " + тип + "\n";
        }
    }
    
    // --- ГЕНЕРАТОРЫ ДЛЯ КОНКРЕТНЫХ УЗЛОВ ---
    
    функция сгенерировать_класс(словарь класс_узел) {
        текст имя = класс_узел["имя"];
        текст родитель = класс_узел["родитель"];
        массив поля = класс_узел["поля"];
        массив методы = класс_узел["методы"];
        
        текст код = "";
        
        // Объявление класса
        если (родитель != "") {
            код = код + "class " + имя + " : public " + родитель + " {\n";
        } иначе {
            код = код + "class " + имя + " {\n";
        }
        
        код = код + "public:\n";
        
        // Поля
        целое j = 0;
        пока (j < длина(поля)) {
            словарь поле = поля[j];
            текст cpp_тип = этот.сопоставить_тип(поле["тип"]);
            текст cpp_имя = поле["имя"];
            
            код = код + "    " + cpp_тип + " " + cpp_имя + ";\n";
            j = j + 1;
        }
        
        код = код + "\n";
        
        // Конструктор (функция инициализация)
        текст имеет_конструктор = ложь;
        целое k = 0;
        пока (k < длина(методы)) {
            словарь метод = методы[k];
            если (метод["имя"] == "инициализация") {
                имеет_конструктор = истина;
                
                код = код + "    " + имя + "(";
                
                // Параметры конструктора
                массив параметры = метод["параметры"];
                целое p = 0;
                пока (p < длина(параметры)) {
                    словарь парам = параметры[p];
                    текст cpp_ptype = этот.сопоставить_тип(парам["тип"]);
                    текст cpp_pname = парам["имя"];
                    
                    код = код + cpp_ptype + " " + cpp_pname;
                    если (p < длина(параметры) - 1) { 
                        код = код + ", "; 
                    }
                    p = p + 1;
                }
                код = код + ") {\n";
                
                // Инициализация полей значениями по умолчанию (заглушка для MVP)
                // В реальной версии здесь должна быть логика присваивания аргументов полям
                целое m = 0;
                пока (m < длина(поля)) {
                    словарь f = поля[m];
                    текст значение_по_умолчанию = "0";
                    если (f["тип"] == "текст") { значение_по_умолчанию = "\"\""; }
                    если (f["тип"] == "логическое") { значение_по_умолчанию = "false"; }
                    
                     // this.field = default_value;
                    код = код + "        этот." + f["имя"] + " = " + значение_по_умолчанию + ";\n";
                    m = m + 1;
                }
                
                код = код + "    }\n";
            }
            k = k + 1;
        }
        
        // Другие методы
        целое n = 0;
        пока (n < длина(методы)) {
            словарь метод = методы[n];
            если (метод["имя"] != "инициализация") {
                // Пока предполагаем void возврат, так как типы возврата сложно вывести без полного AST
                текст тип_возврата = "void"; 
                
                код = код + "    " + тип_возврата + " " + метод["имя"] + "(";
                
                массив параметры = метод["параметры"];
                целое q = 0;
                пока (q < длина(параметры)) {
                    словарь парам = параметры[q];
                    текст cpp_ptype = этот.сопоставить_тип(парам["тип"]);
                    текст cpp_pname = парам["имя"];
                    
                    код = код + cpp_ptype + " " + cpp_pname;
                    если (q < длина(параметры) - 1) { код = код + ", "; }
                    q = q + 1;
                }
                код = код + ") {\n";
                
                // Тело метода (упрощенно)
                код = код + "        // TODO: Сгенерировать тело метода " + метод["имя"] + "\n";
                код = код + "    }\n";
            }
            n = n + 1;
        }
        
        код = код + "};\n\n";
        вернуть код;
    }
    
    функция сгенерировать_функцию(словарь функц_узел) {
        текст имя = функц_узел["имя"];
        текст тип_возврата = "auto"; // Автоопределение типа
        
        текст код = "    " + тип_возврата + " " + имя + "(";
        
        массив параметры = функц_узел["параметры"];
        целое i = 0;
        пока (i < длина(параметры)) {
            словарь парам = параметры[i];
            текст cpp_ptype = этот.сопоставить_тип(парам["тип"]);
            текст cpp_pname = парам["имя"];
            
            код = код + cpp_ptype + " " + cpp_pname;
            если (i < длина(параметры) - 1) { код = код + ", "; }
            i = i + 1;
        }
        код = код + ") {\n";
        код = код + "        // TODO: Тело функции\n";
        код = код + "    }\n";
        
        вернуть код;
    }
    
    функция сгенерировать_переменную(словарь перем_узел) {
        текст имя = перем_узел["имя"];
        текст тип = перем_узел["тип"];
        текст cpp_тип = этот.сопоставить_тип(тип);
        
        // Инициализация значением по умолчанию
        текст значение = "0";
        если (тип == "текст") { значение = "\"\""; }
        если (тип == "логическое") { значение = "false"; }
        
        вернуть "    " + cpp_тип + " " + имя + " = " + значение + ";\n";
    }
    
    функция сгенерировать_вывод(словарь вывод_узел) {
        // std::cout << expr << std::endl;
        текст выражение = этот.сгенерировать_выражение(вывод_узел["выражение"]);
        вернуть "    std::cout << " + выражение + " << std::endl;\n";
    }
    
    функция сгенерировать_возврат(словарь возр_узел) {
        текст выражение = этот.сгенерировать_выражение(возр_узел["выражение"]);
        вернуть "    return " + выражение + ";\n";
    }
    
    // Упрощенная генерация выражений (литералы и переменные)
    функция сгенерировать_выражение(словарь узел) {
        текст тип = узел["тип"];
        
        если (тип == "ЧисловойЛитерал") {
            вернуть узел["значение"];
        } иначе_если (тип == "СтроковыйЛитерал") {
            вернуть "\"" + узел["значение"] + "\"";
        } иначе_если (тип == "Идентификатор") {
            // Если это поле объекта obj.field -> obj.field
            // Если это локальная переменная -> name
            вернуть узел["имя"];
        } иначе {
            вернуть "/* Выражение не поддерживается */";
        }
    }
    
    // Маппинг типов ЯМО на типы C++
    функция сопоставить_тип(текст тип_ямо) {
        если (тип_ямо == "целое") { вернуть "Целое"; }
        если (тип_ямо == "дробное") { вернуть "Дробное"; }
        если (тип_ямо == "текст") { вернуть "Текст"; }
        если (тип_ямо == "логическое") { вернуть "Логическое"; }
        
        // Для массивов и других сложных типов нужна дополнительная логика
        вернуть "auto"; // Безопасная заглушка
    }
}

// Главный входной пункт для тестирования транспилера
функция запустить_транспилер() {
    вывод "=== ЗАПУСК ТРАНСПИЛЕРА ЯМО -> C++ ===";
    
    // Здесь будет логика чтения .ямо файла, парсинга в AST и вызова Транспилер.создать_код()
    // Пока что просто демонстрируем создание экземпляра
    
    Транспилер tr = новый Транспилер("output_generated.cpp");
    
    вывод "✓ Транспилер инициализирован.";
    вывод "⚠️ Полная интеграция требует подключения к нативному парсеру C++.";
}